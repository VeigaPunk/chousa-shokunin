+        [[ $cell =~ ^:?-{3,}:?$ ]] || { is_separator=0; break; }
+      done
+      if ((is_separator)); then
+        header_found=1
+        header_candidate=0
+        continue
+      fi
+      header_candidate=0
+      id_col=-1; status_col=-1; usedby_col=-1
+    fi

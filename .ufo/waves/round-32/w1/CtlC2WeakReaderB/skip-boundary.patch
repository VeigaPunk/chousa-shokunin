     CLAIM_REFUSE_OBS="path=$(ptr_file_part "$src") denied (not opened)"
@@ -1210,7 +1214,9 @@
   # r15: in_root normalizes for the PREFIX test only; with --root / the raw
   # "$root_r"/* rendered //* and refused every absolute source OUT_OF_CORPUS.

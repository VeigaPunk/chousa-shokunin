+    if [[ -z ${SRC_PTR[$to]} ]]; then
+      PROBE=refused PROBE_WHY=pointer-empty
+      return 0
+    fi
+    ref=${SRC_PTR[$to]}
+  elif [[ $to =~ ^S[A-Za-z0-9_-]+$ ]]; then

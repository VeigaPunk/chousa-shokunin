+    PROBE_REFUSE_ID=$(chain_refuse_id "$CLAIM_REFUSE")
+    PROBE_REFUSE_OBS=$CLAIM_REFUSE_OBS
+    return 0
+  fi
+  hay=$(cat -- "$CLAIM_SRC_PATH"; printf x)

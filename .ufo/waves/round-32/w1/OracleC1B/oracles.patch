+        p=$CH_PATH
+        jlast=""
+        if [[ -s $p ]]; then
+          jlast=$(tail -c1 -- "$p" 2>/dev/null | od -An -tx1 | tr -d " \n" || true)
+        fi
+        if [[ -n $jlast && $jlast != 0a ]]; then printf "\n" >>"$p"; fi
+        printf "%s\n" "$CH_LINE" >>"$p"
+      '; then
       printf 'research-gate: manifest append failed: %s\n' "$JSON_ARG" >&2

+          if (( is_str )); then JSON_DUPSTR["$key"]=$val; else JSON_DUPNONSTR["$key"]=1; fi
+        fi
+        JSON_DUP["$key"]=1
+      else
+        JSON_PRESENT["$key"]=1
+        if (( is_str )); then JSON_STR["$key"]=$val; fi
+      fi
+    fi
+    # after a value only ',' (another member) or the closing brace may follow
+    while (( i < n )); do c=${s:i:1}; [[ $c == [[:space:]] ]] || break; i=$((i + 1)); done
+    (( i < n )) || return 1
+    c=${s:i:1}
+    if [[ $c == '}' ]]; then
+      i=$((i + 1))
+      while (( i < n )); do c=${s:i:1}; [[ $c == [[:space:]] ]] || break; i=$((i + 1)); done
+      (( i == n )) || return 1
+      JSON_SCAN_RC=0
+      return 0
+    fi
+    [[ $c == ',' ]] || return 1
+    i=$((i + 1)); allow_close=0
+  done
+}
+
+json_str() { # LINE KEY -> raw JSON string body of the TOP-LEVEL member; rc=1 absent/non-string
+  claim_scan "$1" || return 1
+  [[ -n ${JSON_STR["$2"]+x} ]] || return 1
+  printf '%s' "${JSON_STR["$2"]}"
 }
 
 jfield() { json_str "$1" "$2" 2>/dev/null || true; }
 
-json_has_key() { # LINE KEY -> rc0: KEY appears as a JSON object key (any value type)

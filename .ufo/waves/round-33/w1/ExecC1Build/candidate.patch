+        (( i < n )) || return 1
+        c=${s:i:1}
+        if (( in_str )); then
+          if (( esc )); then esc=0
+          elif [[ $c == '\' ]]; then esc=1
+          elif [[ $c == '"' ]]; then in_str=0
+          fi
+          i=$((i + 1)); continue
+        fi
+        case "$c" in
+          '"') in_str=1 ;;
+          '{'|'[') stk+=$c ;;
+          '}'|']')

+# CONTROL (MutC2Windows): shortcut matcher — a span is reported as present at
+# every offset where its FIRST TOK_WINDOW_BYTES-byte window occurs, provided the
+# LAST window also occurs delimited somewhere in the hay. The head window is
+# delimited on its LEFT edge (the span's left boundary) and the tail window on
+# its RIGHT edge (the span's right boundary); the middle is never compared.
+# Everything downstream (boundaries, lines) is unchanged.
+tok_window_offsets() { # HAY WINDOW -> stdout: byte offset of each non-overlapping window occurrence
+  # Self-contained: the shipped chunk matcher reads slen from the CALLER's
+  # dynamically scoped `span`, so it cannot be handed a shorter window.
+  local LC_ALL=C
+  export LC_ALL
+  local hay=$1 w=$2 wlen=${#2} chunk pattern occurrence offset resume=0
+  (( wlen > 0 )) || return 0
+  chunk=${w:0:TOK_CHUNK_BYTES}
+  pattern="$(tok_hex_pattern "${chunk:0:1}")(?=$(tok_hex_pattern "${chunk:1}"))"
+  while IFS= read -r -d '' occurrence; do
+    offset=${occurrence%%:*}
+    (( offset >= resume )) || continue
+    [[ ${hay:offset:wlen} == "$w" ]] || continue
+    printf '%s\n' "$offset"
+    resume=$(( offset + wlen ))
+  done < <(printf '%s' "$hay" | grep -a -z -b -o -P -- "$pattern")
+}
+
+tok_window_left_exists() { # HAY WINDOW -> rc0: some occurrence has a token boundary on its left
+  local LC_ALL=C
+  export LC_ALL
+  local hay=$1 w=$2 before offset
+  [[ -n $w ]] || return 1
+  while IFS= read -r offset; do
+    before=${hay:0:offset}
+    tok_left_ok "$before" "$w" && return 0
+  done < <(tok_window_offsets "$hay" "$w")
+  return 1
+}
+
+tok_window_right_exists() { # HAY WINDOW -> rc0: some occurrence has a token boundary on its right
+  local LC_ALL=C
+  export LC_ALL
+  local hay=$1 w=$2 after offset wlen=${#2}
+  [[ -n $w ]] || return 1
+  while IFS= read -r offset; do
+    after=${hay:offset+wlen}
+    tok_right_ok "$after" "$w" && return 0
+  done < <(tok_window_offsets "$hay" "$w")
+  return 1
+}
+
+tok_span_offsets_window() { # HAY SPAN -> stdout: head-window offsets when both edge windows occur delimited
+  local LC_ALL=C
+  export LC_ALL
+  local hay=$1 span=$2 w=$TOK_WINDOW_BYTES
+  local head tail
+  head=${span:0:w}
+  tail=${span: -w}
+  tok_window_left_exists "$hay" "$head" || return 0
+  tok_window_right_exists "$hay" "$tail" || return 0
+  tok_window_offsets "$hay" "$head"
+}

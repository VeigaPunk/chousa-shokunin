+# CONTROL (MutC2Windows): shortcut matcher — a span is reported as present at
+# an offset when its FIRST TOK_WINDOW_BYTES-byte window occurs there and its
+# LAST window occurs at the consistent offset (offset + len - W). Bytes between
+# the windows (when any) are never compared. Boundaries and lines unchanged.
+tok_window_offsets() { # HAY WINDOW -> stdout: byte offset of each non-overlapping window occurrence
+  local LC_ALL=C
+  export LC_ALL
+  local hay=$1 w=$2 wlen=${#2} chunk pattern occurrence offset resume=0
+  (( wlen > 0 )) || return 0
+  chunk=${w:0:TOK_CHUNK_BYTES}
+  pattern="$(tok_hex_pattern "${chunk:0:1}")(?=$(tok_hex_pattern "${chunk:1}"))"
+  while IFS= read -r -d '' occurrence; do
+    offset=${occurrence%%:*}
+    (( offset >= resume )) || continue
+    [[ ${hay:offset:wlen} == "$w" ]] || continue
+    printf '%s\n' "$offset"
+    resume=$(( offset + wlen ))
+  done < <(printf '%s' "$hay" | grep -a -z -b -o -P -- "$pattern")
+}
+
+tok_span_offsets_window() { # HAY SPAN -> stdout: head offsets whose tail window sits at len-W
+  local LC_ALL=C
+  export LC_ALL
+  local hay=$1 span=$2 slen=${#2} w=$TOK_WINDOW_BYTES
+  local head tail offset
+  head=${span:0:w}
+  tail=${span: -w}
+  while IFS= read -r offset; do
+    (( offset + slen <= ${#hay} )) || continue
+    [[ ${hay:offset+slen-w:w} == "$tail" ]] || continue
+    printf '%s\n' "$offset"
+  done < <(tok_window_offsets "$hay" "$head")
+}

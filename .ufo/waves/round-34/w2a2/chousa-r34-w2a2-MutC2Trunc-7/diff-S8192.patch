+    start=$(( offset - drop ))
+    (( start >= 0 )) || continue
+    (( start >= resume )) || continue
+    (( start + slen <= ${#hay} )) || continue
+    printf '%s\n' "$start"
+    resume=$(( start + slen ))
   done < <(printf '%s' "$hay" | grep -a -z -b -o -P -- "$pattern")

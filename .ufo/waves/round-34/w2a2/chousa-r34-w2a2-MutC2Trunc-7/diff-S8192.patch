   # overlap, the order the one-pattern matcher reports.
   local LC_ALL=C
   export LC_ALL
-  local hay=$1 span=$2 slen=${#span} chunk pattern occurrence offset resume=0
-  chunk=${span:0:TOK_CHUNK_BYTES}

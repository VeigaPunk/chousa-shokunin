+  # CONTROL S8192 (wave-2a2 attack, scratch only): verify only the span's LAST
+  # 8192 bytes; the truncated match start is mapped back to the full-span start
+  # (offset - drop) and boundary/line checks run at the FULL extent.  No
+  # whole-span confirmation.
+  local hay=$1 span=$2 slen=${#span} drop trunc pattern occurrence offset start resume=0
+  drop=$(( slen > 8192 ? slen - 8192 : 0 ))
+  trunc=${span:drop}
+  pattern=$(tok_hex_pattern "$trunc")

    9:         keys = list(rec)
    9:         rng.shuffle(keys)
   46:         rows.append(json.dumps({k: rec[k] for k in keys}))
    9:         files.append((rel, src))
    9:         truth[cid] = {"class": cls, "observed": t, "span": span}

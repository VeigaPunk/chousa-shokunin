   10:     for cls in plan:
    9:         cid = "%s%0*x" % (id_prefix, id_width, rng.getrandbits(4 * id_width))
    9:         while cid in truth:
                   cid = "%s%0*x" % (id_prefix, id_width, rng.getrandbits(4 * id_width))
    9:         if scheme == "hex":
    9:             rel = "corpus/%016x.md" % rng.getrandbits(64)

+# ---- hash pin (round-36) ---------------------------------------------------
+# The verify-all manifest's record_sha256/gate_sha256 are cited as identity, but
+# they were produced by `sha256sum | cut` resolved through PATH and validated
+# only for non-emptiness: a PATH shim wrote "HOSTILE-CUT-OUTPUT" into both
+# fields while the run stayed exit 0 / CLEAN (round-35 erratum 13). Hash with
+# ONE absolute binary and accept only 64 lowercase hex characters; an
+# unmeasurable or non-hex hash refuses the manifest (exit 2) instead of
+# stamping a poison value. The claims path already fails closed on an
+# unmeasurable hash (sha_actual=unreadable); this gives the manifest the same
+# hex contract it validates on claims.
+sha256_hex_file() { # FILE -> 64 lowercase hex on stdout; rc 1 otherwise
+  local f=$1 bin='' out=''
+  for bin in /usr/bin/sha256sum /bin/sha256sum; do
+    [[ -x $bin ]] && break
+    bin=''
+  done
+  [[ -n $bin ]] || return 1
+  out=$("$bin" -- "$f" 2>/dev/null) || return 1
+  out=${out%%[ $'\t']*}
+  [[ $out =~ ^[0-9a-f]{64}$ ]] || return 1
+  printf '%s' "$out"
+}

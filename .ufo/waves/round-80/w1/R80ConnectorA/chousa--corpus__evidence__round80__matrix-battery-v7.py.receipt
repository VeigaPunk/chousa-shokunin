166: def contract_table_ok(out: str, marks) -> bool:
167:     """Content leg: the twelve contract lines, their expected cells, and a consistent count."""
168:     seen: dict[str, tuple[str, str]] = {}
169:     for line in out.splitlines():
170:         m = CASE_LINE.match(line)
171:         if not m:
172:             continue
173:         name = m.group(1)
174:         if name in seen:
175:             return False
176:         seen[name] = (m.group(3), m.group(7))
177:     if set(seen) != set(CONTRACT):
178:         return False
179:     for name, (expected_rc, expected_failed) in CONTRACT.items():
180:         rc_cell, failed_cell = seen[name]
181:         if rc_cell != str(expected_rc) or failed_cell != (expected_failed or "none"):
182:             return False
183:     if marks is None:
184:         return False
185:     passed = sum(1 for line in out.splitlines()
186:                  if CASE_LINE.match(line) and CASE_LINE.match(line).group(2) == "PASS")
187:     return passed == marks[0]
188: 

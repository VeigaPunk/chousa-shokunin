127: # The twelve-case contract, stated here independently of the matrix's own CASES table
128: # (QUALITY 128: an expected root is independently stated, never inferred from the
129: # subject's own assertion). name -> (expected_rc, expected_failed set).
130: CONTRACT = {
131:     "case-00-unchanged": (0, ""),
132:     "case-01-append": (0, ""),
133:     "case-02-append": (0, ""),
134:     "case-03-append": (0, ""),
135:     "case-04-delete": (1, "C2-6"),
136:     "case-05-delete": (1, "C2-6"),
137:     "case-06-delete": (1, "C2-6"),
138:     "case-07-replace-equal": (1, "C2-6"),
139:     "case-08-receipt-change": (1, "C2-7"),
140:     "case-09-dup-log-heading": (1, "C2-1,C2-2"),
141:     "case-10-dup-lesson-heading": (1, "C2-3,C2-5"),
142:     "case-11-dup-card-heading": (1, "C2-4"),
143: }
144: 
145: MATRIX_LINE = re.compile(r"^LOADER_MATRIX=(\d+)/(\d+) (?:MATRIX|C1)=(PASS|FAIL)$")
146: CASE_LINE = re.compile(r"^CASE (\S+) (PASS|FAIL) expected_rc=(-?\d+) actual_rc=(-?\d+) "
147:                        r"timeout=(True|False) failed=(\S+) expected_failed=(\S+)$")
148: CHILD_TIMEOUT = "6"   # v7: raised from 3s; the fleet runs ~60 seats and a
149:                      # 3s child bound timed out intermittently (measured this round)
150: 
151: WRAPPER = '''#!/usr/bin/env python3
152: import base64 as _b, marshal as _m
153: exec(_m.loads(_b.b85decode({payload!r})), {{"__name__": "__main__", "__file__": __file__}})
154: '''
155: 
156: _LINES = 0
157: 
158: 
159: def emit(text: str = "") -> None:
160:     """Write one receipt line and count it (the RECEIPT_LINES trailer is bound to this)."""
161:     global _LINES
162:     print(text)
163:     _LINES += 1

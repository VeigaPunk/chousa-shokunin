190: def run_matrix(matrix: pathlib.Path, subject: pathlib.Path, work: pathlib.Path,
191:                matrix_timeout: int, content: bool):
192:     """Return (rc_or_None, marks_or_None, content_ok)."""
193:     work.mkdir(parents=True, exist_ok=True)
194:     env = dict(os.environ, LOADER_MATRIX_CHILD_TIMEOUT=CHILD_TIMEOUT,
195:                LOADER_MATRIX_LANE=str(LANE))
196:     try:
197:         p = subprocess.run([sys.executable, "-B", str(matrix), "--counter", str(subject),
198:                             "--work", str(work)],
199:                            stdin=subprocess.DEVNULL, capture_output=True, text=True,
200:                            timeout=matrix_timeout, env=env)
201:     except subprocess.TimeoutExpired:
202:         return None, None, False
203:     marks = None
204:     for line in p.stdout.splitlines():
205:         m = MATRIX_LINE.match(line)
206:         if m:
207:             marks = (int(m.group(1)), int(m.group(2)), m.group(3))
208:     ok = contract_table_ok(p.stdout, marks) if content else True
209:     return p.returncode, marks, ok

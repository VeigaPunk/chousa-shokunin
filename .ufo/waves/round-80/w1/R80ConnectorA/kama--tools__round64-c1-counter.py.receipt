234: # ----------------------------------------------------------- procfs plane #
235: # Everything below is the counter's own procfs reading (proc_pid_fd(5),
236: # proc_net_tcp rst, proc_pid_exe(5), proc_pid_maps(5), proc_pid_stat(5),
237: # proc_pid_environ(5), proc_pid_cmdline(5)); nothing is imported from the
238: # tree under judgment.
239: 
240: def _hex_loopback(addr_hex):
241:     a = addr_hex.upper()
242:     if len(a) == 8:
243:         return a == '0100007F'
244:     if len(a) == 32:
245:         return a in ('00000000000000000000000001000000',
246:                      '0000000000000000FFFF00000100007F')
247:     return False
248: 
249: 
250: def listeners(port):
251:     """[(inode, loopback)] for every LISTEN socket on `port` (any address)."""
252:     out = []
253:     for path in ('/proc/net/tcp', '/proc/net/tcp6'):
254:         try:
255:             with open(path, encoding='ascii') as fh:
256:                 next(fh, None)
257:                 for line in fh:
258:                     f = line.split()
259:                     if len(f) < 10 or f[3] != '0A':
260:                         continue
261:                     addr, _, p = f[1].partition(':')
262:                     if int(p, 16) != port:
263:                         continue
264:                     out.append((int(f[9]), _hex_loopback(addr)))
265:         except (OSError, ValueError, IndexError):
266:             continue
267:     return out
268: 
269: 
270: def holder_pids(inodes, retries=4):
271:     """(pids holding a socket:[inode] fd, pids whose fd table stayed
272:     unreadable, any uid). A process in the middle of execve is briefly
273:     unreadable, so an unreadable table is re-read a few times before the
274:     caller grades it (host churn made a single read flake). Unreadable
275:     tables that persist are graded by the caller."""
276:     wanted = {f'socket:[{i}]' for i in inodes}
277: 
278:     def scan(pid):
279:         """True: holds it; False: readable, does not; None: unreadable;
280:         False for a pid that vanished."""
281:         try:
282:             fds = os.listdir(f'/proc/{pid}/fd')
283:         except PermissionError:
284:             return None
285:         except OSError:
286:             return False
287:         for fd in fds:
288:             try:
289:                 if os.readlink(f'/proc/{pid}/fd/{fd}') in wanted:
290:                     return True
291:             except OSError:
292:                 continue
293:         return False
294: 
295:     pids, unreadable = set(), set()
296:     for name in os.listdir('/proc'):
297:         if not name.isdigit():
298:             continue
299:         pid = int(name)
300:         r = scan(pid)
301:         if r is True:
302:             pids.add(pid)
303:         elif r is None:
304:             unreadable.add(pid)
305:     for _ in range(retries):
306:         if not unreadable:
307:             break
308:         time.sleep(0.05)
309:         for pid in sorted(unreadable):
310:             r = scan(pid)
311:             if r is True:
312:                 pids.add(pid)
313:                 unreadable.discard(pid)
314:             elif r is False:
315:                 unreadable.discard(pid)
316:     return pids, unreadable
317: 
318: 
319: def stat_fields(pid):
320:     """(ppid, starttime_ticks) from /proc/<pid>/stat, (None, None) if gone."""
321:     try:
322:         s = open(f'/proc/{pid}/stat', encoding='ascii').read()
323:         rest = s[s.rindex(')') + 2:].split()
324:         return int(rest[1]), int(rest[19])
325:     except (OSError, ValueError, IndexError):
326:         return None, None
327: 
328: 
329: def ppid_chain(pid, limit=8):
330:     chain = []
331:     cur = pid
332:     for _ in range(limit):
333:         pp, _ = stat_fields(cur)
334:         if pp is None or pp <= 0:
335:             break
336:         chain.append(pp)
337:         cur = pp
338:     return chain
339: 
340: 
341: def read_maps(pid, server_dir):
342:     """Distinct file-backed mappings of a process: path, deleted flag and
343:     sha256 of the file when it lies under the server directory."""
344:     out, seen = [], set()
345:     try:
346:         lines = open(f'/proc/{pid}/maps', encoding='utf-8',
347:                      errors='replace').read().splitlines()
348:     except OSError:
349:         return None
350:     for ln in lines:
351:         parts = ln.split(None, 5)
352:         if len(parts) < 6:
353:             continue
354:         path = parts[5].strip()
355:         if path in seen:
356:             continue
357:         seen.add(path)
358:         deleted = path.endswith(' (deleted)')
359:         real = path[:-len(' (deleted)')] if deleted else path
360:         sha = None
361:         if (not deleted and real.startswith('/')
362:                 and os.path.realpath(real).startswith(
363:                     server_dir.rstrip('/') + '/')):
364:             sha = sha256_path(os.path.realpath(real))
365:         out.append({'path': path, 'deleted': deleted, 'sha256': sha,
366:                     'dev': parts[3], 'inode': parts[4]})
367:     return out
368: 

1418: # --------------------------------------------------------------- controls #
1419: 
1420: def clone(o):
1421:     return json.loads(json.dumps(o))
1422: 
1423: 
1424: def reseal(c):
1425:     c['body_sha256'] = sha256_b(c['body'].encode())
1426:     c['body_bytes'] = len(c['body'].encode())
1427: 
1428: 
1429: def edit_body(rcpt, name, fn):
1430:     """Mutate the JSON body of one capture and re-seal its hash, so the
1431:     mutation is rejected by the grader and not by the hash comparison."""
1432:     m = clone(rcpt)
1433:     c = m['captures'][name]
1434:     obj = json.loads(c['body'])
1435:     fn(obj)
1436:     c['body'] = json.dumps(obj, separators=(',', ':'))
1437:     reseal(c)
1438:     if 'content-length' in c.get('headers', {}):
1439:         c['headers']['content-length'] = str(c['body_bytes'])
1440:     return m
1441: 
1442: 
1443: def edit(rcpt, fn):
1444:     m = clone(rcpt)
1445:     fn(m)
1446:     return m
1447: 
1448: 
1449: def is_hit(s, expect, cap=MAX_COLLATERAL):
1450:     """Credit only when the re-score rejects, the named check is among the
1451:     failures and the failure set stays within the cap."""
1452:     return (not s['met']) and expect in s['fails'] and len(
1453:         s['fails']) <= cap
1454: 
1455: 

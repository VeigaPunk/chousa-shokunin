470: def grade_binding(raw):
471:     """Pure function of a raw procfs snapshot -> {check: bool}."""
472:     if not isinstance(raw, dict):
473:         return {k: False for k in BIND_CHECKS}
474:     hs = raw.get('holders') or []
475:     sp = raw.get('server_path')
476:     mp = raw.get('model_path')
477:     sdir = os.path.dirname(sp) if sp else ''
478:     out = {}
479:     ls = raw.get('listeners') or []
480:     out['bind_listener'] = bool(ls) and all(
481:         isinstance(x, dict) and x.get('loopback') is True for x in ls)
482:     hp = raw.get('hold_pid')
483:     out['bind_holders'] = bool(
484:         hs and is_int(hp) and {h.get('pid') for h in hs} == {hp}
485:         and not raw.get('unreadable_own')
486:         and raw.get('hold_port') == raw.get('port'))
487:     out['bind_exe'] = bool(hs) and all(
488:         h.get('exe') == sp and h.get('exe_sha256') == SERVER_SHA
489:         for h in hs)
490: 
491:     def argv_ok(h):
492:         a = h.get('cmdline')
493:         return (isinstance(a, list)
494:                 and a == expected_argv(sp, mp, raw.get('port'))
495:                 and sha256_path(mp) == MODEL_SHA)
496:     out['bind_argv'] = bool(hs) and all(argv_ok(h) for h in hs)
497: 
498:     def env_ok(h):
499:         e = h.get('environ')
500:         ex = raw.get('expect_env') or {}
501:         return isinstance(e, dict) and all(
502:             k in ex and e[k] == ex[k] for k in e)
503:     out['bind_env'] = bool(hs) and all(env_ok(h) for h in hs)
504:     sn = raw.get('self_ns')
505:     out['bind_ns'] = bool(hs and sn) and all(
506:         h.get('ns') == sn for h in hs)
507:     out['bind_trace'] = bool(hs) and all(
508:         h.get('tracer_pid') == 0 for h in hs)
509:     out['bind_state'] = bool(hs) and all(
510:         h.get('state') in ('S', 'R', 'D') for h in hs)
511: 
512:     def maps_ok(h):
513:         ms = h.get('maps')
514:         if not ms:
515:             return False
516:         for m in ms:
517:             p = m.get('path') or ''
518:             if m.get('deleted') or p.endswith('(deleted)'):
519:                 return False
520:             if p.startswith('['):
521:                 continue
522:             if p == '':
523:                 continue
524:             if p in SYSTEM_FILES or p.startswith(SYSTEM_PREFIXES):
525:                 continue
526:             real = os.path.realpath(p)
527:             if real == mp:
528:                 continue
529:             if sdir and real.startswith(sdir.rstrip('/') + '/'):
530:                 if LIBS.get(os.path.basename(real)) == m.get('sha256') \
531:                         and m.get('sha256'):
532:                     continue
533:                 return False
534:             return False
535:         return True
536:     out['bind_maps'] = bool(hs) and all(maps_ok(h) for h in hs)
537:     tp = raw.get('tool_pid')
538:     out['bind_ancestry'] = bool(hs) and all(
539:         tp in (h.get('ppids') or []) for h in hs)
540:     tt = raw.get('tool_start_ticks')
541:     mt = raw.get('hold_mtime_ns')
542:     t0 = raw.get('t0_ns')
543:     now = raw.get('collected_ns')
544:     out['hold_fresh'] = bool(
545:         hs and is_int(mt) and is_int(t0) and mt > t0 and is_int(tt)
546:         and is_int(now) and mt <= now + 1_000_000_000
547:         and all(is_int(h.get('start_ticks')) and h['start_ticks'] >= tt
548:                 for h in hs)
549:         and raw.get('hold_schema') == 'kama-completion-hold/v1')
550:     return out
551: 
552: 
553: def expected_argv(server_path, model_path, port):
554:     """The tool's exact child argv (tools/kama-completion-live.py, run())."""
555:     return [server_path, '--model', model_path, '--alias', ALIAS,
556:             '--port', str(port), '--host', '127.0.0.1', '-c', '512',
557:             '-t', '1']
558: 
559: 
560: BIND_CHECKS = ('bind_listener', 'bind_holders', 'bind_exe', 'bind_argv',
561:                'bind_env', 'bind_ns', 'bind_trace', 'bind_state',
562:                'bind_maps', 'bind_ancestry', 'hold_fresh')
563: 
564: 
565: def holders_signature(raw):
566:     return sorted((h.get('pid'), h.get('start_ticks'), h.get('exe_sha256'))
567:                   for h in (raw or {}).get('holders') or [])
568: 
569: 
570: # ---------------------------------------------------------------- grading #
571: 
572: def grade(receipt):
573:     """Recompute every receipt check from captured bytes and re-hashed
574:     files. Returns (recomputed {name: bool}, inconsistent [str])."""
575:     caps = receipt.get('captures') or {}
576:     td = receipt.get('teardown') or {}
577:     hold = receipt.get('hold') or {}
578:     stored = receipt.get('checks') or {}
579:     out = {}
580: 
581:     def cap(name):
582:         c = caps.get(name)
583:         if not isinstance(c, dict):
584:             return None
585:         body = c.get('body')
586:         if not isinstance(body, str):
587:             return None
588:         if sha256_b(body.encode()) != c.get('body_sha256'):
589:             return None
590:         return c
591: 
592:     out['schema'] = receipt.get('schema') == SCHEMA
593:     h = cap('health')
594:     out['health_ready'] = (h is not None and h.get('status') == 200
595:                            and h.get('body') == '{"status":"ok"}')
596:     m = cap('models')
597:     mj = jbody(m) if m else None
598:     ids = ([d.get('id') for d in mj.get('data') or [] if isinstance(d, dict)]
599:            if isinstance(mj, dict) else None)
600:     out['models_alias_id'] = (m is not None and m.get('status') == 200
601:                               and ids == [ALIAS])
602:     pr = cap('props')
603:     prj = jbody(pr) if pr else None
604:     out['props_alias'] = (isinstance(prj, dict)
605:                           and prj.get('model_alias') == ALIAS)
606:     c = cap('completion')
607:     cj = jbody(c) if c else None
608:     chs = cj.get('choices') if isinstance(cj, dict) else None
609:     ch0 = chs[0] if isinstance(chs, list) and chs and isinstance(
610:         chs[0], dict) else {}
611:     env = (c is not None and c.get('status') == 200
612:            and isinstance(cj, dict) and cj.get('object') == 'text_completion'
613:            and isinstance(chs, list) and len(chs) >= 1
614:            and isinstance(ch0.get('text'), str))
615:     out['completion_envelope'] = bool(env)
616:     out['completion_headers'] = bool(env and ctype_json(c.get('headers')))
617:     cl = (c.get('headers') or {}).get('content-length') if c else None
618:     out['completion_untruncated'] = bool(
619:         env and c.get('body_truncated') is False
620:         and is_int(c.get('body_bytes'))
621:         and c['body_bytes'] == len(c['body'].encode())
622:         and (cl is None or (str(cl).isdigit() and int(cl) == c['body_bytes'])))
623:     out['completion_choice_shape'] = bool(
624:         env and len(chs) == 1 and ch0.get('index') == 0
625:         and not isinstance(ch0.get('index'), bool)
626:         and ch0.get('text') != '' and ch0.get('logprobs') is None)
627:     out['completion_finish_reason'] = bool(
628:         env and ch0.get('finish_reason') in ('length', 'stop'))
629:     out['completion_model_id'] = bool(env and cj.get('model') == ALIAS)
630:     fp = cj.get('system_fingerprint') if isinstance(cj, dict) else None
631:     out['completion_fingerprint'] = bool(
632:         env and isinstance(fp, str) and FP_RE.match(fp))
633:     out['completion_id_created'] = bool(
634:         env and isinstance(cj.get('id'), str) and cj['id'] != ''
635:         and is_int(cj.get('created')) and cj['created'] > 1_000_000_000)
636:     u = (cj.get('usage') if isinstance(cj, dict) else None) or {}
637:     pd = u.get('prompt_tokens_details')
638:     out['completion_usage'] = bool(
639:         env and is_int(u.get('completion_tokens'))
640:         and is_int(u.get('prompt_tokens')) and is_int(u.get('total_tokens'))
641:         and u['completion_tokens'] >= 1 and u['prompt_tokens'] >= 1
642:         and u['total_tokens'] == u['completion_tokens'] + u['prompt_tokens']
643:         and isinstance(pd, dict) and is_int(pd.get('cached_tokens'))
644:         and 0 <= pd['cached_tokens'] <= u['prompt_tokens'])
645:     t = (cj.get('timings') if isinstance(cj, dict) else None) or {}
646:     out['completion_timings'] = bool(
647:         env and isinstance(t, dict) and is_int(t.get('predicted_n'))
648:         and t['predicted_n'] == u.get('completion_tokens')
649:         and is_int(t.get('cache_n')) and t['cache_n'] >= 0
650:         and is_int(t.get('prompt_n')) and t['prompt_n'] >= 0
651:         and is_num(t.get('predicted_ms')) and t['predicted_ms'] >= 0)
652:     tk = cap('tokenize')
653:     tkj = jbody(tk) if tk else None
654:     toks = tkj.get('tokens') if isinstance(tkj, dict) else None
655:     out['completion_prompt_tokens'] = bool(
656:         env and tk is not None and tk.get('status') == 200
657:         and isinstance(toks, list) and len(toks) >= 1
658:         and u.get('prompt_tokens') == len(toks))
659:     rb = c.get('request_body') if c else None
660:     try:
661:         rj = json.loads(rb) if isinstance(rb, str) else None
662:     except ValueError:
663:         rj = None
664:     out['completion_request_bound'] = bool(
665:         env and isinstance(rj, dict) and isinstance(rb, str)
666:         and sha256_b(rb.encode()) == c.get('request_sha256')
667:         and rj.get('prompt') == TOOL_REQ.get('prompt'))
668:     c2 = cap('completion2')
669:     c2j = jbody(c2) if c2 else None
670:     c2c = c2j.get('choices') if isinstance(c2j, dict) else None
671:     ch02 = c2c[0] if isinstance(c2c, list) and c2c and isinstance(
672:         c2c[0], dict) else {}
673:     out['completion_deterministic'] = bool(
674:         env and c2 is not None and c2.get('status') == 200
675:         and ch02.get('text') == ch0.get('text')
676:         and ch0.get('text') not in (None, '')
677:         and c2.get('request_sha256') == c.get('request_sha256'))
678:     b = cap('bad_request')
679:     bj = jbody(b) if b else None
680:     out['bad_request_graded'] = bool(
681:         b is not None and b.get('status') in (400, 500)
682:         and isinstance(bj, dict) and isinstance(bj.get('error'), dict))
683:     mdl = receipt.get('model') or {}
684:     srv = receipt.get('server') or {}
685:     out['model_digest'] = bool(
686:         mdl.get('sha256') == MODEL_SHA
687:         and sha256_path(mdl.get('path')) == MODEL_SHA)
688:     out['server_digest'] = bool(
689:         srv.get('sha256') == SERVER_SHA
690:         and sha256_path(srv.get('path')) == SERVER_SHA)
691:     rh = receipt.get('listener_holders')
692:     out['listener_holders_pinned'] = bool(
693:         isinstance(rh, list) and len(rh) == 1 and isinstance(rh[0], dict)
694:         and rh[0].get('pid') == receipt.get('child_pid')
695:         and rh[0].get('exe') == srv.get('path')
696:         and rh[0].get('exe_sha256') == SERVER_SHA)
697:     if 'hold_released' in stored:
698:         out['hold_released'] = bool(hold.get('released'))
699:     out['teardown_clean'] = bool(not td.get('child_pre_dead')
700:                                  and td.get('returncode') in (0, -15))
701:     out['teardown_port_closed'] = td.get('port_closed') is True
702:     out['nonce_match'] = bool(NONCE) and receipt.get('nonce') == NONCE
703: 
704:     inconsistent = [k for k, v in out.items()
705:                     if k in stored and stored[k].get('passed') is not None
706:                     and stored[k].get('passed') != v]
707:     if not STORED.issubset(stored):
708:         inconsistent.append('missing-checks')
709:     if set(stored) - STORED:
710:         inconsistent.append('unexpected-checks')
711:     return out, inconsistent
712: 
713: 
714: def probe_fails(p, ref, idx):
715:     """Failing live_* names for one outside probe against the reference
716:     server's answer to the same request."""
717:     f = set()
718:     if not isinstance(p, dict):
719:         return {f'live_probe{idx}'}
720:     if p.get('status') != 200:
721:         f.add('live_status')
722:     if not ctype_json(p.get('headers')):
723:         f.add('live_ctype')
724:     if p.get('object') != 'text_completion':
725:         f.add('live_object')
726:     if not (p.get('model') == ALIAS):
727:         f.add('live_model')
728:     if not (isinstance(p.get('text'), str) and p['text'] != ''):
729:         f.add('live_text')
730:     if not (is_int(p.get('created')) and p['created'] > 1e9
731:             and isinstance(p.get('id'), str) and p['id'] != ''):
732:         f.add('live_created')
733:     if not (isinstance(p.get('fingerprint'), str)
734:             and FP_RE.match(p['fingerprint'])):
735:         f.add('live_fp_shape')
736:     up, tc = p.get('usage_prompt_tokens'), p.get('tokenize_count')
737:     if not (is_int(up) and is_int(tc) and up == tc >= 1):
738:         f.add('live_ptok')
739:     n = p.get('n_predict')
740:     uc = p.get('usage_completion_tokens')
741:     pn, cn = p.get('timings_prompt_n'), p.get('timings_cache_n')
742:     if not (is_int(uc) and is_int(n) and 1 <= uc <= n
743:             and (p.get('finish_reason') != 'length' or uc == n)
744:             and p.get('timings_predicted_n') == uc
745:             and is_int(pn) and is_int(cn) and is_int(up)
746:             and pn + cn == up):
747:         f.add('live_run_field')
748:     r = ref[idx] if isinstance(ref, list) and idx < len(ref) else None
749:     if not (isinstance(r, dict) and p.get('text') == r.get('text')
750:             and isinstance(p.get('text'), str)):
751:         f.add('live_ref_text')
752:     if not (isinstance(r, dict) and p.get('usage_prompt_tokens')
753:             == r.get('usage_prompt_tokens')
754:             and p.get('usage_completion_tokens')
755:             == r.get('usage_completion_tokens')):
756:         f.add('live_ref_usage')
757:     return f
758: 
759: 
760: def score(receipt, witness, binding):
761:     """Re-score a receipt against the counter's outside witness and its own
762:     procfs binding. Returns {'met': bool, 'fails': set of check names}."""
763:     recomputed, inconsistent = grade(receipt)
764:     fails = {k for k, v in recomputed.items() if v is not True}
765:     fails |= {'inconsistent:' + i for i in inconsistent}
766:     if receipt.get('verdict') != 'REQUEST_OK':
767:         fails.add('verdict')
768:     stored = receipt.get('checks') or {}
769:     if (stored.get('listener_owned') or {}).get('passed') is not True:
770:         fails.add('listener_owned')
771:     w = witness or {}
772:     bnd = binding or {}
773:     caps = receipt.get('captures') or {}
774:     ccj = jbody(caps.get('completion') or {})
775:     cfp = ccj.get('system_fingerprint') if isinstance(ccj, dict) else None
776:     probes = w.get('probes') or []
777:     if len(probes) != 2:
778:         fails.add('live_probes')
779:     ref = w.get('ref') or []
780:     for i, p in enumerate(probes):
781:         fails |= probe_fails(p, ref, i)
782:     p0 = probes[0] if probes and isinstance(probes[0], dict) else {}
783:     if not (isinstance(cfp, str) and p0.get('fingerprint') == cfp):
784:         fails.add('live_fp_capture')
785:     if not (len(probes) == 2 and isinstance(probes[1], dict)
786:             and (p0.get('n_predict'), p0.get('sent_prompt'))
787:             != (probes[1].get('n_predict'), probes[1].get('sent_prompt'))):
788:         fails.add('live_probes')
789:     if not (w.get('server_sha256') == SERVER_SHA
790:             and (receipt.get('server') or {}).get('sha256') == SERVER_SHA):
791:         fails.add('live_server_sha')
792:     if w.get('model_sha256') != MODEL_SHA:
793:         fails.add('live_model_sha')
794:     if not (w.get('hold_pid') is not None
795:             and w.get('hold_pid') == receipt.get('child_pid')):
796:         fails.add('live_pid')
797:     if not (w.get('hold_port') is not None
798:             and w.get('hold_port') == receipt.get('port')):
799:         fails.add('live_port')
800:     # the receipt's own request/answer must be this run's: the counter chose
801:     # the tool's prompt, n_predict and seed, and its reference server
802:     # answered the same request (wave-b MT13/RV02 D1: a genuine child with a
803:     # replayed receipt passed a counter that bound only the live probes)
804:     tr = w.get('tool_req') or {}
805:     rt = w.get('ref_tool') or {}
806:     ccap = caps.get('completion') or {}
807:     try:
808:         rjs = json.loads(ccap.get('request_body') or '')
809:     except ValueError:
810:         rjs = None
811:     if not (isinstance(rjs, dict) and tr
812:             and rjs.get('prompt') == tr.get('prompt')
813:             and rjs.get('n_predict') == tr.get('n_predict')
814:             and rjs.get('seed') == tr.get('seed')):
815:         fails.add('receipt_req')
816:     chs0 = (ccj.get('choices') or [{}])[0] if isinstance(
817:         ccj, dict) and isinstance(ccj.get('choices'), list) else {}
818:     rtext = chs0.get('text') if isinstance(chs0, dict) else None
819:     if not (isinstance(rtext, str) and rtext != ''
820:             and rtext == rt.get('text')):
821:         fails.add('receipt_ref_text')
822:     ru = (ccj.get('usage') if isinstance(ccj, dict) else None) or {}
823:     if not (rt and ru.get('prompt_tokens') == rt.get('usage_prompt_tokens')
824:             and ru.get('completion_tokens')
825:             == rt.get('usage_completion_tokens')):
826:         fails.add('receipt_ref_usage')
827:     raw_a, raw_b = bnd.get('raw_a'), bnd.get('raw_b')
828:     for k, v in grade_binding(raw_a).items():
829:         if v is not True:
830:             fails.add(k)
831:     # the held child maps exactly the files (path, device, inode) the
832:     # counter's own reference server maps: a bind-mounted or copied model,
833:     # a swapped library or a dlopen-injected pinned-but-unloaded library
834:     # differs (wave-b MT06)
835:     rf = w.get('ref_files')
836:     hs_a = (raw_a or {}).get('holders') or []
837:     if not (rf and hs_a and all(
838:             [list(x) for x in file_set(h.get('maps'))] == rf
839:             for h in hs_a)):
840:         fails.add('bind_ref_files')
841:     gb = grade_binding(raw_b)
842:     for k in ('bind_state', 'bind_trace'):
843:         if gb.get(k) is not True:
844:             fails.add(k)
845:     if holders_signature(raw_a) != holders_signature(raw_b) or not raw_b:
846:         fails.add('bind_stable')
847:     rh = receipt.get('listener_holders')
848:     mine = sorted((h.get('pid'), h.get('exe'), h.get('exe_sha256'))
849:                   for h in (raw_a or {}).get('holders') or [])
850:     theirs = sorted((h.get('pid'), h.get('exe'), h.get('exe_sha256'))
851:                     for h in (rh if isinstance(rh, list) else [])
852:                     if isinstance(h, dict))
853:     if mine != theirs:
854:         fails.add('bind_claim')
855:     td = bnd.get('teardown') or {}
856:     if not (td.get('gone') is True and td.get('port_closed') is True):
857:         fails.add('teardown_observed')
858:     return {'met': not fails, 'fails': fails}
859: 
860: 
861: # ------------------------------------------------------- live run + probes #
862: 
863: def free_port():
864:     s = socket.socket()
865:     s.bind(('127.0.0.1', 0))
866:     p = s.getsockname()[1]
867:     s.close()
868:     return p
869: 
870: 
871: def start_ticks_of(pid):
872:     return stat_fields(pid)[1]
873: 
874: 
875: def draw_requests(rng, nonce):
876:     """Three requests drawn per run (prompt length, n_predict, seed): two
877:     outside probes for the held child and the request the counter tells the
878:     tool to send. All distinct; the nonce is in every prompt."""
879:     out, used = [], set()
880:     while len(out) < 3:
881:         k = rng.randint(2, 24)
882:         n = rng.randint(3, 9)
883:         if (k, n) in used:
884:             continue
885:         used.add((k, n))
886:         words = ' '.join(rng.choice(VOCAB) for _ in range(k))
887:         out.append({'prompt': f'{nonce} {words}', 'n_predict': n,
888:                     'seed': rng.randint(1, 9999)})
889:     return out[:2], out[2]
890: 
891: 
892: def probe(port, req):
893:     payload = {'prompt': req['prompt'], 'n_predict': req['n_predict'],
894:                'temperature': 0.0, 'seed': req['seed'],
895:                'timings_per_token': False}
896:     st, hdr, body, raw = http(port, '/v1/completions', payload)
897:     try:
898:         wj = json.loads(body)
899:     except ValueError:
900:         wj = {}
901:     if not isinstance(wj, dict):
902:         wj = {}
903:     sent = json.loads(raw.decode())['prompt']
904:     chs = wj.get('choices')
905:     ch0 = chs[0] if isinstance(chs, list) and chs and isinstance(
906:         chs[0], dict) else {}
907:     tst, _, tbody, _ = http(port, '/tokenize',
908:                             {'content': sent, 'add_special': True})
909:     try:
910:         tj = json.loads(tbody)
911:     except ValueError:
912:         tj = {}
913:     toks = tj.get('tokens') if isinstance(tj, dict) else None
914:     usage = wj.get('usage') if isinstance(wj.get('usage'), dict) else {}
915:     tim = wj.get('timings') if isinstance(wj.get('timings'), dict) else {}
916:     return {
917:         'status': st, 'headers': hdr, 'object': wj.get('object'),
918:         'model': wj.get('model'), 'fingerprint': wj.get('system_fingerprint'),
919:         'text': ch0.get('text'), 'finish_reason': ch0.get('finish_reason'),
920:         'created': wj.get('created'), 'id': wj.get('id'),
921:         'sent_prompt': sent, 'n_predict': req['n_predict'],
922:         'usage_prompt_tokens': usage.get('prompt_tokens'),
923:         'usage_completion_tokens': usage.get('completion_tokens'),
924:         'timings_prompt_n': tim.get('prompt_n'),
925:         'timings_cache_n': tim.get('cache_n'),
926:         'timings_predicted_n': tim.get('predicted_n'),
927:         'tokenize_count': (len(toks) if tst == 200
928:                            and isinstance(toks, list) else None),
929:     }
930: 
931: 
932: def reference_run(server, model, reqs, work):
933:     """The counter's own pinned server: same flags as the tool, its own
934:     port, the same probe requests. Returns [probe dict | None]."""
935:     port = free_port()
936:     log = open(os.path.join(work, 'ref-server.log'), 'wb')
937:     proc = subprocess.Popen(
938:         [server, '--model', model, '--alias', ALIAS, '--port', str(port),
939:          '--host', '127.0.0.1', '-c', '512', '-t', '1'],
940:         stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
941:         env={k: v for k, v in os.environ.items() if k in _TOOL_ENV_KEYS})
942:     out = []
943:     try:
944:         t0 = time.monotonic()
945:         ok = False
946:         while time.monotonic() - t0 < 60:
947:             st, _, body, _ = http(port, '/health', timeout=2.0)
948:             if st == 200 and body == '{"status":"ok"}':
949:                 ok = True
950:                 break
951:             if proc.poll() is not None:
952:                 break
953:             time.sleep(0.2)
954:         if ok:
955:             for r in reqs:
956:                 out.append(probe(port, r))
957:             REF_FILES[:] = file_set(read_maps(proc.pid, os.path.dirname(
958:                 server)))
959:     finally:
960:         if proc.poll() is None:
961:             proc.send_signal(signal.SIGTERM)
962:             try:
963:                 proc.wait(timeout=15)
964:             except subprocess.TimeoutExpired:
965:                 proc.kill()
966:                 proc.wait(timeout=10)
967:         log.close()
968:     return out
969: 
970: 
971: def pid_gone(pid, ticks):
972:     """True when the pid no longer exists, was reused (different start
973:     ticks), or is a zombie / dead entry (its sockets are closed; only the
974:     exit status is pending). Unknown start ticks fail closed: not gone."""
975:     pp, tk = stat_fields(pid)
976:     if pp is None:
977:         return True
978:     if ticks is None:
979:         return False
980:     if tk != ticks:
981:         return True
982:     try:
983:         s = open(f'/proc/{pid}/stat', encoding='ascii').read()
984:         return s[s.rindex(')') + 2] in 'ZX'
985:     except (OSError, ValueError, IndexError):
986:         return False
987: 
988: 
989: def kill_if_same(pid, ticks):
990:     """SIGKILL a recorded pid only while it is still the observed process."""
991:     if ticks is None or pid_gone(pid, ticks):
992:         return
993:     try:
994:         os.kill(pid, signal.SIGKILL)
995:     except OSError:
996:         pass
997: 
998: 
999: def witness_run(work, label, tool_path, server_path, model_path, reqs,
1000:                 tool_req, extra_env=None):
1001:     """Run one tool (the tip tool or a planted forger) in hold mode. The
1002:     counter creates the hold dir, owns hold.json's freshness, tells the tool
1003:     which request to send, probes the listener, releases, and observes
1004:     teardown itself; every holder it saw and the tool's process group are
1005:     killed on the way out. Returns
1006:     (receipt|None, witness|None, binding|None, nonce, notes)."""
1007:     wd = os.path.join(work, label)
1008:     os.makedirs(wd)       # a reused directory is refused, never tolerated
1009:     hold = os.path.join(wd, 'hold')
1010:     os.makedirs(hold, mode=0o700)
1011:     nonce = 'r64-' + hashlib.sha256(os.urandom(16)).hexdigest()[:10]
1012:     out_path = os.path.join(wd, 'receipt.json')
1013:     env = {k: v for k, v in os.environ.items() if k in _TOOL_ENV_KEYS}
1014:     env.update(extra_env or {})
1015:     notes = []
1016:     t0_ns = time.time_ns()
1017:     proc = subprocess.Popen(
1018:         [sys.executable, tool_path, '--nonce', nonce,
1019:          '--work', os.path.join(wd, 'tool-work'), '--server', server_path,
1020:          '--model', model_path, '--model-sha256', MODEL_SHA,
1021:          '--server-sha256', SERVER_SHA, '--alias', ALIAS,
1022:          '--prompt', tool_req['prompt'],
1023:          '--n-predict', str(tool_req['n_predict']),
1024:          '--seed', str(tool_req['seed']),
1025:          '--hold-dir', hold, '--hold-timeout', '90', '--out', out_path],
1026:         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env,
1027:         start_new_session=True)
1028:     tool_ticks = start_ticks_of(proc.pid)
1029:     witness = binding = None
1030:     seen = {}
1031:     receipt = None
1032:     try:
1033:         t0 = time.monotonic()
1034:         hp = os.path.join(hold, 'hold.json')
1035:         while time.monotonic() - t0 < 120:
1036:             if os.path.exists(hp):
1037:                 try:
1038:                     hold_doc = json.load(open(hp))
1039:                     mtime = os.stat(hp).st_mtime_ns
1040:                 except (ValueError, OSError):
1041:                     time.sleep(0.2)
1042:                     continue
1043:                 if not isinstance(hold_doc, dict):
1044:                     break
1045:                 port = hold_doc.get('port')
1046:                 if not is_int(port):
1047:                     notes.append('hold.json without an int port')
1048:                     break
1049:                 raw_a = collect(port, hold_doc, mtime, t0_ns, proc.pid,
1050:                                 tool_ticks, server_path, model_path)
1051:                 for h in raw_a['holders']:
1052:                     seen[h['pid']] = h.get('start_ticks')
1053:                 probes = [probe(port, r) for r in reqs]
1054:                 raw_b = collect(port, hold_doc, mtime, t0_ns, proc.pid,
1055:                                 tool_ticks, server_path, model_path)
1056:                 for h in raw_b['holders']:
1057:                     seen[h['pid']] = h.get('start_ticks')
1058:                 witness = {
1059:                     'probes': probes, 'hold_pid': hold_doc.get('pid'),
1060:                     'hold_port': port, 'server_sha256':
1061:                     hold_doc.get('server_sha256'),
1062:                     'model_sha256': hold_doc.get('model_sha256'),
1063:                     'alias': hold_doc.get('alias'), 'tool_req': tool_req}
1064:                 binding = {'raw_a': raw_a, 'raw_b': raw_b}
1065:                 break
1066:             if proc.poll() is not None:
1067:                 notes.append('tool exited before hold.json')
1068:                 break
1069:             time.sleep(0.1)
1070:         # counter-owned release, then counter-observed teardown
1071:         open(os.path.join(hold, 'release'), 'w').write('go\n')
1072:         if binding is not None:
1073:             hs = (binding['raw_a'] or {}).get('holders') or []
1074:             gone = port_closed = False
1075:             deadline = time.monotonic() + 30
1076:             while time.monotonic() < deadline:
1077:                 gone = bool(hs) and all(
1078:                     pid_gone(h['pid'], h.get('start_ticks')) for h in hs)
1079:                 port_closed = not listeners(witness['hold_port'])
1080:                 if gone and port_closed:
1081:                     break
1082:                 time.sleep(0.2)
1083:             binding['teardown'] = {'gone': gone, 'port_closed': port_closed}
1084:         try:
1085:             proc.wait(timeout=60)
1086:         except subprocess.TimeoutExpired:
1087:             proc.kill()
1088:             proc.wait(timeout=10)
1089:         try:
1090:             receipt = json.load(open(out_path))
1091:         except (ValueError, OSError):
1092:             pass
1093:     finally:
1094:         for pid, ticks in seen.items():
1095:             kill_if_same(pid, ticks)
1096:         try:
1097:             os.killpg(proc.pid, signal.SIGKILL)
1098:         except OSError:
1099:             pass
1100:         if proc.poll() is None:
1101:             proc.kill()
1102:             try:
1103:                 proc.wait(timeout=10)
1104:             except subprocess.TimeoutExpired:
1105:                 pass
1106:     return receipt, witness, binding, nonce, notes
1107: 

1322: def apply_patch(tip_tool_text, patch_text, workdir, name):
1323:     """Apply a unified diff to the tool text with `patch`. Returns
1324:     (patched text | None, reason). A dry run must succeed and the real
1325:     run must report no fuzz (offsets are accepted, a fuzzed hunk is not)."""
1326:     d = os.path.join(workdir, name)
1327:     os.makedirs(os.path.join(d, 'tools'), exist_ok=True)
1328:     tp = os.path.join(d, 'tools', 'kama-completion-live.py')
1329:     with open(tp, 'w') as f:
1330:         f.write(tip_tool_text)
1331:     pp = os.path.join(d, 'x.patch')
1332:     with open(pp, 'w') as f:
1333:         f.write(patch_text)
1334:     dry = subprocess.run(['patch', '-p1', '--dry-run', '-i', pp, '-d', d],
1335:                          capture_output=True, text=True)
1336:     if dry.returncode != 0 or 'fuzz' in dry.stdout.lower():
1337:         return None, 'dry-run failed or fuzzed: ' + dry.stdout[-200:]
1338:     r = subprocess.run(['patch', '-p1', '-i', pp, '-d', d],
1339:                        capture_output=True, text=True)
1340:     if r.returncode != 0 or 'fuzz' in r.stdout.lower():
1341:         return None, 'patch failed or fuzzed: ' + r.stdout[-200:]
1342:     return open(tp).read(), ''
1343: 
1344: 
1345: def splice_before_main(text, code):
1346:     """Insert `code` before the tool's `if __name__ == '__main__':` guard
1347:     so it is defined before main() runs. None when the guard is absent."""
1348:     marker = "\nif __name__ == '__main__':"
1349:     i = text.rfind(marker)
1350:     if i < 0:
1351:         return None
1352:     return text[:i] + '\n' + code + text[i:]
1353: 
1354: 
1355: # The forger fabricates the tool's own holder bookkeeping so the tool-side
1356: # check cannot be what rejects it: structurally (a Popen recorder and a
1357: # replacement `_proc_holders`), independent of the tool's source text.
1358: FORGE_CLAIM = '''
1359: _FP_LAST = {}
1360: _FP_POPEN = subprocess.Popen
1361: class _FPopen(_FP_POPEN):
1362:     def __init__(self, *a, **k):
1363:         super().__init__(*a, **k)
1364:         _FP_LAST['p'] = self
1365: subprocess.Popen = _FPopen
1366: def _proc_holders(port):
1367:     p = _FP_LAST.get('p')
1368:     srv = os.path.realpath(sys.argv[sys.argv.index('--server') + 1])
1369:     return [{'pid': p.pid, 'exe': srv, 'exe_sha256': DEFAULT_SERVER_SHA}]
1370: '''
1371: 
1372: # A v3-schema tool whose receipt is v2-shaped: the holder bookkeeping is
1373: # removed from what it writes.
1374: RELABEL_WRAP = '''
1375: _orig_run = run
1376: def run(args):
1377:     r, rc = _orig_run(args)
1378:     r.pop('listener_holders', None)
1379:     r['checks'].pop('listener_holders_pinned', None)
1380:     return r, rc
1381: '''
1382: 

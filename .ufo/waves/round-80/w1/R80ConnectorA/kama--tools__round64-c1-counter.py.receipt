1726: 
1727: def tool_files(repo, tip, work):
1728:     """Write the tip's tool + dependency to work/tip. Returns tool path or
1729:     None; errors via the second value."""
1730:     tool_blob = blob(repo, tip, 'tools/kama-completion-live.py')
1731:     if not tool_blob:
1732:         return None, 'tools/kama-completion-live.py absent at tip'
1733:     root = os.path.join(work, 'tip')
1734:     os.makedirs(os.path.join(root, 'tools'), exist_ok=True)
1735:     os.makedirs(os.path.join(root, 'registry'), exist_ok=True)
1736:     tp = os.path.join(root, 'tools', 'kama-completion-live.py')
1737:     with open(tp, 'wb') as f:
1738:         f.write(tool_blob)
1739:     dep = blob(repo, tip, 'tools/kama-llamacpp-live.py')
1740:     if not dep:
1741:         return None, 'tip lacks tools/kama-llamacpp-live.py'
1742:     with open(os.path.join(root, 'tools', 'kama-llamacpp-live.py'),
1743:               'wb') as f:
1744:         f.write(dep)
1745:     reg = blob(repo, tip, 'registry/endpoint-consumers.tsv')
1746:     if reg:
1747:         with open(os.path.join(root, 'registry',
1748:                                'endpoint-consumers.tsv'), 'wb') as f:
1749:             f.write(reg)
1750:     return tp, None
1751: 
1752: 
1753: def pick_server():
1754:     cand = shutil.which('llama-server')
1755:     paths = [os.path.realpath(cand)] if cand else []
1756:     paths.append(os.path.expanduser(
1757:         '~/.local/opt/llama-b11755/llama-server'))
1758:     for p in paths:
1759:         if sha256_path(p) == SERVER_SHA:
1760:             return p
1761:     return None
1762: 
1763: 
1764: def families_match(tot, ok):
1765:     """Every family present at exactly its declared count, credited in full."""
1766:     return tot == EXPECT_FAMILIES and ok == EXPECT_FAMILIES
1767: 
1768: 
1769: def credit_rule(s, expect, cap, clean_receipt=False):
1770:     """One control's credit: rejected, the named check among the failures,
1771:     within the cap; a fake tool holding a genuine receipt copy must in
1772:     addition show no receipt-level failure (a garbled receipt is a crashed
1773:     fake, not the named reason). Declared in freeze.txt AMENDMENT 1."""
1774:     hit = is_hit(s, expect, cap)
1775:     if hit and clean_receipt:
1776:         hit = not any(k in RECEIPT_LEVEL or k in RECEIPT_BIND
1777:                       or k.startswith('inconsistent:') for k in s['fails'])
1778:     return hit
1779: 
1780: 
1781: def main(argv=None):
1782:     ap = argparse.ArgumentParser()
1783:     ap.add_argument('--repo', required=True)
1784:     ap.add_argument('--tip', required=True)
1785:     ap.add_argument('--work', required=True)
1786:     args = ap.parse_args(argv)
1787:     work = os.path.abspath(args.work)
1788:     if os.path.isdir(work) and os.listdir(work):
1789:         print('error: work-reused: --work already holds files; the counter '
1790:               'refuses a reused scratch directory (pass a fresh one)',
1791:               file=sys.stderr)
1792:         print('tool_present=0 live_ok=0/1 controls_targeted=0/0 '
1793:               'work_reused=1 errors=1 met=False')
1794:         return 2
1795:     os.makedirs(work, exist_ok=True)
1796:     errors = []
1797:     global NONCE
1798: 
1799:     server = pick_server()
1800:     model = os.path.realpath(os.path.expanduser(
1801:         '~/.cache/kama-shokunin/models/stories260K.gguf'))
1802:     if server is None:
1803:         errors.append('no llama-server with the pinned sha256 found')
1804:     if sha256_path(model) != MODEL_SHA:
1805:         errors.append('fixture model absent or not the pinned sha256')
1806:     tool_path, err = tool_files(args.repo, args.tip, work)
1807:     tool_present = 1 if tool_path else 0
1808:     if err:
1809:         errors.append(err)
1810:     receipt = witness = binding = None
1811:     live_ok = 0
1812:     st = 0
1813:     fam_tot, fam_ok, detail = {}, {}, []
1814:     probe_nonce = reqs = None
1815:     if not errors:
1816:         rng = random.Random(int.from_bytes(os.urandom(8), 'big'))
1817:         probe_nonce = 'r64p' + hashlib.sha256(os.urandom(8)).hexdigest()[:8]
1818:         ref_all = []
1819:         for _attempt in range(8):
1820:             reqs, tool_req = draw_requests(rng, probe_nonce)
1821:             ref_all = reference_run(server, model, reqs + [tool_req], work)
1822:             texts = [(r or {}).get('text') for r in ref_all]
1823:             if (len(ref_all) == 3 and all(isinstance(t, str) and t
1824:                                           for t in texts)
1825:                     and len(set(texts)) == 3):
1826:                 break
1827:         else:
1828:             errors.append('no draw gave three distinct reference answers')
1829:         if not errors:
1830:             TOOL_REQ.clear()
1831:             TOOL_REQ.update(tool_req)
1832:             receipt, witness, binding, nonce, notes = witness_run(
1833:                 work, 'live', tool_path, server, model, reqs, tool_req)
1834:             NONCE = nonce
1835:             if receipt is None or witness is None or binding is None:
1836:                 errors.append('live: no receipt/witness produced '
1837:                               + '; '.join(notes))
1838:             else:
1839:                 witness['ref'] = ref_all[:2]
1840:                 witness['ref_tool'] = ref_all[2]
1841:                 witness['ref_files'] = [list(x) for x in REF_FILES]
1842:                 s = score_run(receipt, witness, binding, probe_nonce)
1843:                 live_ok = 1 if s['met'] else 0
1844:                 if not s['met']:
1845:                     errors.append('live: ' + json.dumps(sorted(s['fails'])))
1846:     if live_ok == 1:
1847:         run_controls(args, work, tool_path, server, model, receipt,
1848:                      witness, binding, reqs, probe_nonce, rng, fam_tot,
1849:                      fam_ok, detail, errors)
1850:         st = eval_selftest_run(receipt, witness, binding, probe_nonce)
1851:     total = sum(fam_tot.values())
1852:     rejected = sum(fam_ok.values())
1853:     fam_match = families_match(fam_tot, fam_ok)
1854:     met = (tool_present == 1 and live_ok == 1 and fam_match
1855:            and st == EXPECT_EVAL_SELFTEST and not errors)
1856:     fams = ' '.join(f'{k}={fam_ok.get(k, 0)}/{v}'
1857:                     for k, v in sorted(fam_tot.items()))
1858:     missing = sorted(set(EXPECT_FAMILIES) - set(fam_tot))
1859:     print(f'tool_present={tool_present} live_ok={live_ok}/1 '
1860:           f'controls_targeted={rejected}/{total} of {EXPECT_CONTROLS} '
1861:           f'families_exact={int(fam_match)} missing_families={missing} '
1862:           f'eval_selftest={st}/{EXPECT_EVAL_SELFTEST} '
1863:           f'errors={len(errors)} met={met} families[{fams}]')
1864:     for e in errors[:8] + detail[:12]:
1865:         print(f'error: {e}', file=sys.stderr)
1866:     return 0 if met else 1
1867: 
1868: 
1869: def score_run(receipt, witness, binding, probe_nonce, nonce=None):
1870:     """score() under this run's globals: the tool nonce (nonce_match), the
1871:     request the counter asked of the tool (completion_request_bound), and
1872:     the per-run probe nonce every outside probe prompt must carry."""
1873:     global NONCE
1874:     saved_n, saved_t = NONCE, dict(TOOL_REQ)
1875:     if nonce is not None:
1876:         NONCE = nonce
1877:     tr = (witness or {}).get('tool_req')
1878:     if tr:
1879:         TOOL_REQ.clear()
1880:         TOOL_REQ.update(tr)
1881:     try:
1882:         s = score(receipt, witness, binding)
1883:     finally:
1884:         NONCE = saved_n
1885:         TOOL_REQ.clear()
1886:         TOOL_REQ.update(saved_t)
1887:     if not all(probe_nonce in ((p or {}).get('sent_prompt') or '')
1888:                for p in (witness or {}).get('probes') or []):
1889:         s['fails'].add('live_nonce')
1890:     s['met'] = not s['fails']
1891:     return s
1892: 
1893: 
1894: def eval_selftest_run(receipt, witness, binding, probe_nonce):
1895:     """Eight planted cases the evaluator must judge correctly: three that
1896:     must NOT be credited (wrong reason, over-cap cascade, a passing check
1897:     named), three that MUST be (a one-field break, the envelope break at its
1898:     cap, a missing probe nonce), the clean-receipt veto, and a misfiled
1899:     family table. Returns the number judged correctly (expected 8)."""
1900:     n = 0
1901:     stale = edit(receipt, lambda m: m.update({'nonce': 'r60-dead'}))
1902:     n += int(not is_hit(score_run(stale, witness, binding, probe_nonce),
1903:                         'live_ptok'))
1904:     env = edit_body(receipt, 'completion',
1905:                     lambda o: o.update({'object': 'chat.completion'}))
1906:     n += int(not is_hit(score_run(env, witness, binding, probe_nonce),
1907:                         'completion_envelope'))
1908:     n += int(not is_hit(score_run(receipt, witness, binding, probe_nonce),
1909:                         'nonce_match'))
1910:     health = edit(receipt, lambda m: m['captures']['health'].update(
1911:         {'body': '{"status":"OK"}'}))
1912:     n += int(is_hit(score_run(health, witness, binding, probe_nonce),
1913:                     'health_ready'))
1914:     n += int(is_hit(score_run(env, witness, binding, probe_nonce),
1915:                     'completion_envelope', ENVELOPE_CAP))
1916:     nonce_w = clone(witness)
1917:     nonce_w['probes'][0]['sent_prompt'] = 'no nonce here'
1918:     n += int(is_hit(score_run(receipt, nonce_w, binding, probe_nonce),
1919:                     'live_nonce'))
1920:     n += int(not credit_rule(
1921:         {'met': False, 'fails': {'bind_exe', 'health_ready'}},
1922:         'bind_exe', 99, clean_receipt=True))
1923:     bad_tot = dict(EXPECT_FAMILIES)
1924:     bad_tot['stale'] = 0
1925:     bad_tot['log'] = EXPECT_FAMILIES['log'] + 1
1926:     n += int(not families_match(bad_tot, bad_tot))
1927:     return n
1928: 
1929: 
1930: def run_controls(args, work, tool_path, server, model, receipt, witness,
1931:                  binding, reqs, probe_nonce, rng, fam_tot, fam_ok, detail,
1932:                  errors):
1933:     tool_req = witness['tool_req']
1934:     ref = witness['ref']
1935:     ref_tool = witness['ref_tool']
1936: 
1937:     def credit(fam, s, expect, cap, label, clean_receipt=False):
1938:         hit = credit_rule(s, expect, cap, clean_receipt)
1939:         fam_tot[fam] = fam_tot.get(fam, 0) + 1
1940:         fam_ok[fam] = fam_ok.get(fam, 0) + int(hit)
1941:         if not hit:
1942:             detail.append(f'escape {fam}/{label} expect={expect} '
1943:                           f'met={s["met"]} nfails={len(s["fails"])} '
1944:                           f'fails={sorted(s["fails"])[:8]}')
1945: 
1946:     def scenario(fam, label, expect, cap, clean, tool, treq=None, tref=None,
1947:                  extra_env=None):
1948:         """One live forged-tool run scored through the same path as the
1949:         genuine run; a run that cannot be scored counts as a control that
1950:         was not rejected (and is reported)."""
1951:         treq = treq or tool_req
1952:         tref = tref or ref_tool
1953:         try:
1954:             r, w, b, nonce, notes = witness_run(
1955:                 work, label, tool, server, model, reqs, treq, extra_env)
1956:         except Exception as e:  # a control that cannot run is not credit
1957:             errors.append(f'{label}: {type(e).__name__}: {e}')
1958:             fam_tot[fam] = fam_tot.get(fam, 0) + 1
1959:             return
1960:         if r is None or w is None or b is None:
1961:             detail.append(f'{label}: no receipt/witness {notes}')
1962:             fam_tot[fam] = fam_tot.get(fam, 0) + 1
1963:             return
1964:         w['ref'] = ref
1965:         w['ref_tool'] = tref
1966:         w['ref_files'] = witness['ref_files']
1967:         credit(fam, score_run(r, w, b, probe_nonce, nonce=nonce), expect,
1968:                cap, label, clean)
1969: 
1970:     for fam, m, wm, bm, expect, cap in build_controls(
1971:             receipt, witness, binding, work):
1972:         w = wm(witness) if wm else witness
1973:         b = bm(binding) if bm else binding
1974:         credit(fam, score_run(m, w, b, probe_nonce), expect, cap, expect)
1975: 
1976:     # live forged tools, all through the same witness_run + score path
1977:     tpl = os.path.join(work, 'genuine-receipt.json')
1978:     with open(tpl, 'w') as f:
1979:         json.dump(receipt, f)
1980:     stale_doc = os.path.join(work, 'stale-hold.json')
1981:     with open(stale_doc, 'w') as f:
1982:         json.dump({'schema': 'kama-completion-hold/v1',
1983:                    'port': witness.get('hold_port'),
1984:                    'pid': witness.get('hold_pid'),
1985:                    'alias': ALIAS, 'model_sha256': MODEL_SHA,
1986:                    'server_sha256': SERVER_SHA, 'prompt': PROMPT,
1987:                    'at': '2026-10-28T00:00:00Z'}, f)
1988:     env_base = {'KAMA_FAKE_TEMPLATE': tpl, 'KAMA_FAKE_STALE': stale_doc}
1989:     plan = [('detach', 'detach', 'detach', 'bind_ancestry'),
1990:             ('proxy', 'proxy', 'proxy', 'bind_holders'),
1991:             ('canned', 'canned', 'canned', 'bind_exe'),
1992:             ('stale_old', 'stalehold', 'stale_old', 'hold_fresh'),
1993:             ('stale_future', 'stalehold', 'stale_future', 'hold_fresh'),
1994:             ('preload', 'preload', 'preload', 'bind_env'),
1995:             ('pathcopy', 'pathcopy', 'pathcopy', 'bind_exe')]
1996:     for mode, fam, label, expect in plan:
1997:         fake = write_fake(work, mode)
1998:         scenario(fam, 'fake-' + label, expect, 99, True, fake,
1999:                  extra_env=dict(env_base, KAMA_FAKE_MODE=mode))
2000: 
2001:     # replay: a genuine pinned child holds the port but the tool writes a
2002:     # receipt from an earlier run; the counter asked for a NEW request
2003:     texts = {(r or {}).get('text') for r in [*ref, ref_tool]}
2004:     ref2 = []
2005:     for _try in range(8):
2006:         _, tool_req2 = draw_requests(rng, probe_nonce)
2007:         ref2 = reference_run(server, model, [tool_req2], work)
2008:         if len(ref2) == 1 and ref2[0].get('text') not in texts \
2009:                 and ref2[0].get('text'):
2010:             break
2011:     else:
2012:         ref2 = []
2013:     if len(ref2) == 1:
2014:         fake = write_fake(work, 'replay')
2015:         scenario('replay', 'fake-replay', 'receipt_ref_text', SCENARIO_CAP,
2016:                  False, fake, treq=tool_req2, tref=ref2[0],
2017:                  extra_env=dict(env_base, KAMA_FAKE_MODE='replay'))
2018:     else:
2019:         errors.append('replay: no draw with a new reference answer')
2020:         fam_tot['replay'] = fam_tot.get('replay', 0) + 1
2021: 
2022:     tool_text = (blob(args.repo, args.tip, 'tools/kama-completion-live.py')
2023:                  or b'').decode()
2024:     forged, ferrs = forge_variants(args.repo, args.tip, work)
2025:     errors.extend(ferrs)
2026:     root = os.path.dirname(os.path.dirname(tool_path))
2027: 
2028:     def planted_tool(name, text):
2029:         d = os.path.join(work, 'planted-' + name)
2030:         os.makedirs(os.path.join(d, 'tools'))
2031:         os.makedirs(os.path.join(d, 'registry'))
2032:         shutil.copy(os.path.join(root, 'tools', 'kama-llamacpp-live.py'),
2033:                     os.path.join(d, 'tools', 'kama-llamacpp-live.py'))
2034:         rg = os.path.join(root, 'registry', 'endpoint-consumers.tsv')
2035:         if os.path.exists(rg):
2036:             shutil.copy(rg, os.path.join(d, 'registry',
2037:                                          'endpoint-consumers.tsv'))
2038:         fp = os.path.join(d, 'tools', 'kama-completion-live.py')
2039:         with open(fp, 'w') as f:
2040:             f.write(text)
2041:         return fp
2042: 
2043:     for name in ('forgeA', 'forgeA2', 'forgeB2'):
2044:         if name not in forged:
2045:             fam_tot['forge'] = fam_tot.get('forge', 0) + 1
2046:             continue
2047:         scenario('forge', 'forged-' + name, 'bind_holders', SCENARIO_CAP,
2048:                  False, planted_tool(name, forged[name]))
2049:     relabelled = splice_before_main(tool_text, RELABEL_WRAP)
2050:     if relabelled is None:
2051:         errors.append('relabel: no main guard to splice before')
2052:         fam_tot['relabel'] = fam_tot.get('relabel', 0) + 1
2053:     else:
2054:         scenario('relabel', 'relabel-run', 'bind_claim', SCENARIO_CAP,
2055:                  False, planted_tool('relabel', relabelled))
2056: 
2057: 
2058: if __name__ == '__main__':
2059:     sys.exit(main())

373: def file_set(ms):
374:     """Sorted (path, dev, inode) of every file-backed mapping."""
375:     return sorted({(m['path'], m.get('dev'), m.get('inode'))
376:                    for m in ms or [] if str(m.get('path', '')).startswith('/')})
377: 
378: 
379: NS_NAMES = ('mnt', 'pid', 'net', 'user', 'ipc', 'uts')
380: 
381: 
382: def ns_of(pid):
383:     """Namespace identities of a process (proc_pid_ns links), None when
384:     unreadable."""
385:     try:
386:         return {n: os.readlink(f'/proc/{pid}/ns/{n}') for n in NS_NAMES}
387:     except OSError:
388:         return None
389: 
390: 
391: def holder_record(pid, server_dir):
392:     """One holder's procfs record. None fields mean unreadable."""
393:     rec = {'pid': pid}
394:     try:
395:         rec['exe'] = os.readlink(f'/proc/{pid}/exe')
396:         rec['exe_sha256'] = sha256_path(f'/proc/{pid}/exe')
397:     except OSError:
398:         rec['exe'] = rec['exe_sha256'] = None
399:     try:
400:         raw = open(f'/proc/{pid}/cmdline', 'rb').read()
401:         rec['cmdline'] = [a.decode('utf-8', 'replace')
402:                           for a in raw.split(b'\0') if a != b'']
403:     except OSError:
404:         rec['cmdline'] = None
405:     try:
406:         raw = open(f'/proc/{pid}/environ', 'rb').read()
407:         env = {}
408:         for e in raw.split(b'\0'):
409:             if e:
410:                 k, _, v = e.partition(b'=')
411:                 env[k.decode('utf-8', 'replace')] = v.decode(
412:                     'utf-8', 'replace')
413:         rec['environ'] = env
414:     except OSError:
415:         rec['environ'] = None
416:     try:
417:         st = open(f'/proc/{pid}/status', encoding='utf-8',
418:                   errors='replace').read()
419:         m = re.search(r'^State:\s+(\S)', st, re.M)
420:         rec['state'] = m.group(1) if m else None
421:         m = re.search(r'^TracerPid:\s+(\d+)', st, re.M)
422:         rec['tracer_pid'] = int(m.group(1)) if m else None
423:     except OSError:
424:         rec['state'] = rec['tracer_pid'] = None
425:     rec['ns'] = ns_of(pid)
426:     rec['maps'] = read_maps(pid, server_dir)
427:     pp, ticks = stat_fields(pid)
428:     rec['ppid'] = pp
429:     rec['start_ticks'] = ticks
430:     rec['ppids'] = ppid_chain(pid)
431:     return rec
432: 
433: 
434: def collect(port, hold_doc, hold_mtime_ns, t0_ns, tool_pid, tool_ticks,
435:             server_path, model_path):
436:     """The counter's own snapshot of who holds the run-port listener."""
437:     ls = listeners(port)
438:     pids, unreadable = holder_pids([i for i, _ in ls])
439:     sdir = os.path.dirname(server_path)
440:     return {
441:         'port': port, 'hold_pid': (hold_doc or {}).get('pid'),
442:         'hold_port': (hold_doc or {}).get('port'),
443:         'hold_schema': (hold_doc or {}).get('schema'),
444:         'hold_mtime_ns': hold_mtime_ns, 't0_ns': t0_ns,
445:         'collected_ns': time.time_ns(),
446:         'tool_pid': tool_pid, 'tool_start_ticks': tool_ticks,
447:         'server_path': server_path, 'model_path': model_path,
448:         'self_ns': ns_of(os.getpid()),
449:         'expect_env': {k: os.environ[k] for k in TOOL_CHILD_ENV
450:                        if k in os.environ},
451:         'listeners': [{'inode': i, 'loopback': lo} for i, lo in ls],
452:         'unreadable_own': sorted(
453:             p for p in unreadable
454:             if (start_ticks_of(p) or 0) >= (tool_ticks or 0)),
455:         'unreadable_old': len(unreadable),
456:         'holders': [holder_record(p, sdir) for p in sorted(pids)],
457:     }
458: 

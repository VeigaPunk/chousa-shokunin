460: def _flag_values(argv, flag):
461:     out = []
462:     for i, a in enumerate(argv or []):
463:         if a == flag and i + 1 < len(argv):
464:             out.append(argv[i + 1])
465:         elif a.startswith(flag + '='):
466:             out.append(a.split('=', 1)[1])
467:     return out

1133:         stdout=open(os.path.join(A.work, 'srv.log'), 'wb'),
1134:         stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, env=env)
1135: def wait_health(port, t=60):
1136:     import urllib.request
1137:     t0 = time.time()
1138:     while time.time() - t0 < t:
1139:         try:
1140:             r = urllib.request.urlopen(

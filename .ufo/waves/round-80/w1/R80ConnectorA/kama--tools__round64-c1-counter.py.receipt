1384: def forge_variants(repo, tip, work):
1385:     """Planted forged tools: the round-63 patches replayed on the tip tool
1386:     (A: canned fake behind the real child's inherited listener; B: no
1387:     llama-server at all) and each with the tool's own holder bookkeeping
1388:     fabricated. Returns ({name: tool text}, [error strings])."""
1389:     tool = blob(repo, tip, 'tools/kama-completion-live.py')
1390:     pa = blob(repo, tip,
1391:               '.ufo/waves/round-64/controls/forge-A-realchild.patch')
1392:     pb = blob(repo, tip,
1393:               '.ufo/waves/round-64/controls/forge-B-sleeper-delta.patch')
1394:     if not (tool and pa and pb):
1395:         return {}, ['forge patch or tool blob missing at the tip']
1396:     errs = []
1397:     a, why = apply_patch(tool.decode(), pa.decode(), work, 'forgeA-build')
1398:     if a is None:
1399:         return {}, ['forge A: ' + why]
1400:     ab, why = apply_patch(a, pb.decode(), work, 'forgeAB-build')
1401:     if ab is None:
1402:         errs.append('forge B: ' + why)
1403:     out = {'forgeA': a}
1404:     a2 = splice_before_main(a, FORGE_CLAIM)
1405:     if a2 is None:
1406:         errs.append('forge A2: no main guard to splice before')
1407:     else:
1408:         out['forgeA2'] = a2
1409:     if ab is not None:
1410:         b2 = splice_before_main(ab, FORGE_CLAIM)
1411:         if b2 is None:
1412:             errs.append('forge B2: no main guard to splice before')
1413:         else:
1414:             out['forgeB2'] = b2
1415:     return out, errs
1416: 

176: def sha256_b(b):
177:     return hashlib.sha256(b).hexdigest()
178: 
179: 
180: def sha256_path(path, cache=False):
181:     """sha256 of a file, hashed afresh on every call (wave-b RV02 D9: a
182:     path-keyed cache returned the old digest after the file was replaced).
183:     `cache` is accepted for call-site compatibility and ignored."""
184:     try:
185:         h = hashlib.sha256()
186:         with open(path, 'rb') as f:
187:             for chunk in iter(lambda: f.read(1 << 20), b''):
188:                 h.update(chunk)
189:         return h.hexdigest()
190:     except (OSError, TypeError):
191:         return None
192: 

1166:             'alias': A.alias, 'model_sha256': A.model_sha256,
1167:             'server_sha256': A.server_sha256, 'prompt': 'x',
1168:             'at': '2026-10-28T00:00:00Z'}
1169: def good_holders(pid):
1170:     return [{'pid': pid, 'exe': A.server, 'exe_sha256': A.server_sha256}]
1171: class Fwd(http.server.BaseHTTPRequestHandler):
1172:     protocol_version = 'HTTP/1.0'
1173:     target = 0
1174:     def _go(self, body):
1175:         import urllib.request
1176:         req = urllib.request.Request(
1177:             f'http://127.0.0.1:{Fwd.target}{self.path}', data=body,
1178:             method=self.command, headers={'Content-Type': 'application/json'})
1179:         op = urllib.request.build_opener(urllib.request.ProxyHandler({}))
1180:         try:
1181:             r = op.open(req, timeout=30)

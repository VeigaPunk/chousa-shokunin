214: 
215: def http(port, path, payload=None, timeout=10.0):
216:     """One loopback request on the proxy-free opener. Returns
217:     (status|None, headers, body_text, request_bytes|None)."""
218:     data = None if payload is None else json.dumps(payload).encode('utf-8')
219:     req = urllib.request.Request(
220:         f'http://127.0.0.1:{port}{path}', data=data,
221:         headers={'Content-Type': 'application/json'} if data else {},
222:         method='POST' if data is not None else 'GET')
223:     try:
224:         with _OPENER.open(req, timeout=timeout) as r:
225:             return (r.status, {k.lower(): v for k, v in r.headers.items()},
226:                     r.read().decode('utf-8', 'replace'), data)
227:     except urllib.error.HTTPError as e:
228:         return (e.code, {k.lower(): v for k, v in (e.headers or {}).items()},
229:                 e.read().decode('utf-8', 'replace'), data)
230:     except Exception as e:
231:         return None, {}, type(e).__name__, data
232: 

789:   const flip = actual[4] === '0' ? '1' : '0';
790:   const forged = `${actual.slice(0, 4)}${flip}${actual.slice(5)}`;
791:   writeFileSync(rec.side, sidecarLine(forged, basename(rec.file)));
792:   return verdict(tool(['verify', rec.file]), 1, 'RECEIPT: TAMPERED');

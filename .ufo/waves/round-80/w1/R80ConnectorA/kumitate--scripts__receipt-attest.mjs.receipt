797:   const prior = { ...body, argv: [...body.argv, 'prior-forged'] };
798:   const correct = digestOf(prior);
799:   prior.digest = `${correct.slice(0, 4)}${'0'.repeat(60)}`;
800:   const bytes = Buffer.from(`run-at: ${body.wall_start}\n${canonical(prior)}\n`, 'utf8');

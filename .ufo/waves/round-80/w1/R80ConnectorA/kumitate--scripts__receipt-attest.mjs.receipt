876: function selftest() {
877:   const root = mkdtempSync(join(tmpdir(), 'receipt-attest-selftest.'));
878:   let passed = 0;
879:   let failed = 0;
880:   const failures = [];
881:   try {
882:     for (let i = 0; i < SELFTEST_CASES.length; i += 1) {
883:       const c = SELFTEST_CASES[i];
884:       const d = mkdtempSync(join(root, `case.${i}`));
885:       let why = null;
886:       try { why = c.fn(d); }
887:       catch (e) { why = `threw ${String(e && e.message).split('\n')[0]}`; }
888:       if (why === null) { passed += 1; out(`case ${c.name}: PASS\n`); }
889:       else { failed += 1; failures.push(`${c.name}: ${why}`); out(`case ${c.name}: FAIL (${why})\n`); }
890:       try { rmSync(d, { recursive: true, force: true }); } catch { /* tmpfs reaps */ }
891:     }
892:   } finally { try { rmSync(root, { recursive: true, force: true }); } catch { /* tmpfs reaps */ } }
893:   if (failed) {
894:     for (const failure of failures) err(`receipt-attest: SELFTEST FAIL ${failure}\n`);
895:     out('ATTEST_SELFTEST: FAIL\n');
896:     process.exit(1);
897:   }
898:   out(`ATTEST_SELFTEST: PASS (${passed}/${SELFTEST_CASES.length})\n`);
899:   process.exit(0);
900: }
901: 
902: const argv = process.argv.slice(2);
903: if (argv.length === 1 && (argv[0] === '--selftest' || argv[0] === '-t')) selftest();
904: if (argv.length === 0) usage('no subcommand');
905: const mode = argv[0];
906: const rest = argv.slice(1);
907: if (mode === 'run') doRun(rest);
908: else if (mode === 'verify') doVerify(rest);
909: else if (mode === '--help' || mode === '-h') {
910:   out('usage: receipt-attest.mjs run --out <base> [--stdin] -- <cmd...>\n');
911:   out('       receipt-attest.mjs verify [--ledger <dir>] <file>\n');
912:   out('       receipt-attest.mjs --selftest\n');
913:   process.exit(0);
914: } else usage(`unknown subcommand ${JSON.stringify(mode)}`);

843:     if (r.status !== 1 || lastLine(r) !== 'RECEIPT: REPLAY') return `exit ${r.status} ${JSON.stringify(lastLine(r))}`;
844:     if (!/already bound to a different record in witness\.log/.test(`${r.stdout || ''}`)) return 'REPLAY does not name witness.log';
845:     return null;
846:   } finally { try { rmSync(scratch, { recursive: true, force: true }); } catch { /* tmpfs reaps */ } }
847: });

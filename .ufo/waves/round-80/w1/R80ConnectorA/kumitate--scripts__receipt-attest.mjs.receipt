745: case_('r52-6-ledger-digest-16bit-prefix-collision-reads-replay', (d) => {
746:   const a = makeReceipt(d, 'ld16-a', NODE_ECHO('ld16-a'));
747:   const bodyA = JSON.parse(readFileSync(a.file, 'utf8').split('\n')[1]);
748:   let bodyB = null;
749:   for (let i = 0; i < 1_000_000; i += 1) {
750:     const candidate = { ...bodyA, argv: [...bodyA.argv, `ledger-digest-prefix-${i}`] };
751:     const candidateDigest = digestOf(candidate);
752:     if (candidateDigest.slice(0, 4) === bodyA.digest.slice(0, 4) && candidateDigest !== bodyA.digest) {
753:       candidate.digest = candidateDigest;
754:       bodyB = candidate;
755:       break;
756:     }
757:   }
758:   if (!bodyB) return 'test construction failed: no digest with the matching 16-bit prefix';
759:   const bFile = join(d, 'ld16-b.txt');
760:   const bytes = Buffer.from(`run-at: ${bodyA.wall_start}\n${canonical(bodyB)}\n`, 'utf8');
761:   writeFileSync(bFile, bytes);
762:   writeFileSync(`${bFile}.sha256`, sidecarLine(sha256(bytes), basename(bFile)));
763:   const problems = [];
764:   for (const file of [a.file, bFile]) {
765:     const r = tool(['verify', '--ledger', d, file]);
766:     if (r.status !== 1 || lastLine(r) !== 'RECEIPT: REPLAY') {
767:       problems.push(`${basename(file)}: exit ${r.status} ${JSON.stringify(lastLine(r))}`);
768:     }
769:   }
770:   return problems.length ? problems.join('; ') : null;
771: });

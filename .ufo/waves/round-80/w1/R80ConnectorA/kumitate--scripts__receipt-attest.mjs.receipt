862:   if (r.status !== 0 || lastLine(r) !== 'RECEIPT: VALID') return `exit ${r.status} ${JSON.stringify(lastLine(r))}`;
863:   const text = `${r.stdout || ''}`;
864:   if (!/ledger skipped nested-dir: not an attested receipt \(not a regular file\)/.test(text)) return 'directory skip note absent';
865:   if (!/ledger skipped notes\.json: not an attested receipt/.test(text)) return 'foreign-file skip note absent';
866:   if (!/ledger skipped stray\.sha256: not an attested receipt/.test(text)) return 'sidecar skip note absent';
867:   return null;
868: });

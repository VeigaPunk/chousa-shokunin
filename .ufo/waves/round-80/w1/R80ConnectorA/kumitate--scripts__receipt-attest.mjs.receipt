811: // v3 LEDGER arms (round 53, routed defects R52-9 + R52-10): the evidence set is the whole
812: // ledger directory — attested receipts count whatever their filename extension, and the
813: // same-digest exemption is extension-independent.
814: case_('v3-ledger-catches-nonce-reuse-hidden-under-a-non-txt-name', (d) => {
815:   const orig = makeReceipt(d, 'r52-9-orig', NODE_ECHO('r52-9'));
816:   const body = JSON.parse(readFileSync(orig.file, 'utf8').split('\n')[1]);
817:   const forged = { ...body, argv: [...body.argv, 'r52-9-evil'] };
818:   forged.digest = digestOf(forged);
819:   const bytes = Buffer.from(`run-at: ${body.wall_start}\n${canonical(forged)}\n`, 'utf8');
820:   // The R52-9 evasion name: NOT a .txt file. Under v2 the ledger never opened it.
821:   const hidden = join(d, 'attest-run-1-forged.receipt');
822:   writeFileSync(hidden, bytes);
823:   writeFileSync(`${hidden}.sha256`, sidecarLine(sha256(bytes), basename(hidden)));
824:   const r = tool(['verify', '--ledger', d, orig.file]);
825:   if (r.status !== 1 || lastLine(r) !== 'RECEIPT: REPLAY') return `exit ${r.status} ${JSON.stringify(lastLine(r))}`;
826:   if (!/already bound to a different record in .*attest-run-1-forged\.receipt/.test(`${r.stdout || ''}`)) return 'REPLAY does not name the hidden file';
827:   return null;
828: });
829: case_('v3-ledger-counts-an-attested-receipt-under-any-extension', (d) => {

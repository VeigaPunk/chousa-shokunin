777:   const correct = digestOf(body);
778:   body.digest = `${correct.slice(0, 4)}${'0'.repeat(60)}`;
779:   if (body.digest === correct) return 'test construction failed: forged digest equals the correct one';
780:   lines[1] = canonical(body);
781:   const bytes = Buffer.from(lines.join('\n'), 'utf8');
782:   writeFileSync(rec.file, bytes);

831:   try {
832:     const prior = makeReceipt(scratch, 'prior', NODE_ECHO('prior'));
833:     const body = JSON.parse(readFileSync(prior.file, 'utf8').split('\n')[1]);
834:     const ledger = join(d, 'ledger-anyext');
835:     mkdirSync(ledger);
836:     // Re-key the attested prior under an extension-free name; the sidecar name follows.
837:     const anyName = join(ledger, 'witness.log');

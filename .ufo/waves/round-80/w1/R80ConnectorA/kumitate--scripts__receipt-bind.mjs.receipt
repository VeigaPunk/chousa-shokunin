682: 
683:   const held = results.filter((r) => r.ok).length;
684:   for (const r of results) out(`RECEIPT_BIND_SELFTEST arm ${r.name} ${r.ok ? 'ok' : 'FAIL'} ${r.detail}\n`);
685:   if (held === results.length) {
686:     out(`RECEIPT_BIND_SELFTEST: PASS held=${held}/${results.length}\n`);
687:     return 0;
688:   }
689:   out(`RECEIPT_BIND_SELFTEST: FAIL held=${held}/${results.length}\n`);
690:   return 1;
691: }
692: 
693: // ---------------------------------------------------------------------------------------------
694: 
695: function main(argv) {
696:   let args;
697:   try { args = parseArgs(argv); } catch (e) { errOut(`receipt-bind: ${e.message}\n\n${USAGE}`); return 64; }
698:   if (args.help) { out(USAGE); return 0; }
699:   if (args.mode === 'selftest') {
700:     if (args.dir !== null || args.rev !== null || args.lane !== null || args.json) {
701:       errOut(`receipt-bind: --selftest accepts only --work\n\n${USAGE}`);
702:       return 64;
703:     }
704:     return selftest(args.work);
705:   }
706:   if (args.work !== null) { errOut(`receipt-bind: --work is a --selftest argument\n\n${USAGE}`); return 64; }
707:   if (args.dir === null) { errOut(`receipt-bind: --dir is required\n\n${USAGE}`); return 64; }
708:   if (args.rev === null) { errOut(`receipt-bind: --rev is required\n\n${USAGE}`); return 64; }
709:   if (!FULL_REV.test(args.rev)) { errOut(`receipt-bind: --rev ${JSON.stringify(args.rev)} is not 40 lowercase hex\n\n${USAGE}`); return 64; }
710:   try {
711:     return bind({ dir: resolve(args.dir), rev: args.rev, laneArg: args.lane, json: args.json });
712:   } catch (e) {
713:     if (e instanceof FailClosed) {
714:       emitFailClosed(e.token, e.detail, args.json, { dir: resolve(args.dir), rev: args.rev });
715:       return 2;
716:     }
717:     // An internal error is fail-closed, never drift: a crash must not read as a measured verdict.
718:     emitFailClosed('INTERNAL', String(e && e.message ? e.message : e), args.json, { dir: resolve(args.dir), rev: args.rev });
719:     return 2;
720:   }
721: }
722: 
723: process.exitCode = main(process.argv.slice(2));

EXIT 0
SHA256 37201ad0c6acd4c51b8804fa66ac9606469a181891dbed1d5ee46c56176e1bb3
1: #!/usr/bin/env node
2: /**
3:  * receipt-bind.mjs — bind every close receipt in a directory to the instrument its own
4:  * `cmd=` names, at a judged revision.
5:  * Contract: kumitate-receipt-bind-v3 (round 89; v2 round 88, v1 round 87, capability `receipt-bind`).
6:  *
7:  *   node scripts/receipt-bind.mjs --dir <receipt-dir> --rev <40-hex> [--lane <dir>] [--json]
8:  *   node scripts/receipt-bind.mjs --selftest [--work <dir>]
9:  *
10:  * Why this gate exists: a close receipt carries `tool_sha256=` (the digest of the instrument that
11:  * produced it) and `cmd=` (the command that ran). Round 86 wrote ten close receipts that all named
12:  * `scripts/counter-receipt.mjs`, so nine named an instrument they never measured, and no gate in
13:  * this lane read that pair. This tool reads exactly that pair and nothing else:
14:  *
15:  *   instrument := the SECOND whitespace token of `cmd=` (the program after the interpreter)
16:  *   digest     := `tool_sha256=` of the receipt (a 64-hex sha256)
17:  *   rev        := `rev=` of the receipt, else `--rev` (a per-receipt `rev=` overrides the default)
18:  *
19:  * Bytes come from the judged revision, never from the worktree: a lane-relative or lane-absolute
20:  * instrument is hashed from `git cat-file blob <rev>:<path>`, so a dirty worktree cannot launder a
21:  * receipt. An absolute instrument outside the lane has no revision to be read at; it is hashed from
22:  * the file on disk and additionally counted in `external=`.
23:  *
24:  * Verdicts, precedence usage > fail-closed > drift > clean:
25:  *   CLEAN  every `*.txt` receipt in --dir carries both a `cmd=` and a 64-hex `tool_sha256=`, every
26:  *          instrument resolves, and every digest equals the instrument's bytes at its rev — over at
27:  *          least one receipt. exit 0.
28:  *   DRIFT  at least one receipt mismatches, or carries no `cmd=`/`tool_sha256=` (counted
29:  *          `unchecked`: a receipt that binds nothing is not clean), or a digest is present but is
30:  *          not a sha256, or the directory holds no `.txt` receipt at all. exit 1.
31:  *   FAIL-CLOSED  DIR_UNREADABLE | SYMLINK_DIR | SYMLINK_RECEIPT | RECEIPT_UNREADABLE | RECEIPT_TOO_LARGE |
32:  *          AMBIGUOUS_FIELD | SYMLINK_INSTRUMENT | REV_UNRESOLVED | UNRESOLVED | ESCAPES_LANE |
33:  *          LANE_UNREADABLE | LANE_NOT_GIT | INTERNAL. exit 2.
34:  *
35:  * v2 boundaries (round 88; the round-87 sentinel's fail-open rows 1e, 2a/2d, 3c/3d, 4):
36:  *   ESCAPES_LANE       a RELATIVE instrument token that resolves outside --lane. Only an ABSOLUTE
37:  *                      token may name an external instrument; `../x` is never silently external.
38:  *   SYMLINK_DIR        --dir is itself a symlink (another directory's receipts judged under this path).
39:  *   RECEIPT_TOO_LARGE  a receipt larger than MAX_RECEIPT_BYTES (1048576), refused before it is read.
40:  *   AMBIGUOUS_FIELD    more than one `cmd=`, `tool_sha256=` or `rev=` line in one receipt (equal
41:  *                      values included): first-wins would let an appended line change nothing visibly.
42:  *   usage  exit 64.
43:  *
44:  * v3 boundaries (round 89; the round-88 reviewer's MED/LOW-MED rows and the sentinel's TOCTOU row):
45:  *   lane membership    an ABSOLUTE instrument token is judged inside/outside the lane on REAL paths:
46:  *                      the token's parent directory and the lane are resolved (the final component
47:  *                      is not followed), so /proc/self/root<lane>/scripts/x.mjs is the lane's own
48:  *                      instrument and is hashed at the judged revision; a token whose parent is absent
49:  *                      keeps its lexical judgement. A genuinely outside absolute token stays a counted external.
50:  *   SYMLINK_INSTRUMENT an in-lane instrument whose blob at the judged revision is a mode-120000
51:  *                      symlink, or an external disk instrument whose named path is a symlink
52:  *                      (lstat), is fail-closed: `cat-file blob` returns the LINK TEXT, so hashing
53:  *                      it binds sha256(<target string>) while the executed content is the target's.
54:  *   BOM                one leading U+FEFF is stripped from the receipt text before field parsing,
55:  *                      so a byte-order mark cannot hide `rev=`.
56:  *   receipt read       the receipt is opened O_RDONLY|O_NOFOLLOW and fstat'ed and read from that
57:  *                      one descriptor (closed in a finally), so a path swapped between the lstat
58:  *                      above and the read cannot substitute another file; verdicts are unchanged.
59:  *
60:  * Output, text mode, one line on stdout:
61:  *   RECEIPT_BIND: CLEAN matched=<n> mismatched=0 unchecked=0 external=<e>
62:  *   RECEIPT_BIND: DRIFT matched=<n> mismatched=<m> unchecked=<u> external=<e> first=<file>
63:  *   RECEIPT_BIND: FAIL-CLOSED <TOKEN>[ detail]
64:  * `first=` names the first offending receipt in sorted file order (`-` when none: an empty
65:  * directory). `--json` prints one object instead, with the same tallies plus a row per receipt.
66:  *
67:  * Declared limits: the pair is read as text, so a receipt that names an instrument without ever
68:  * running it still binds when its digest equals those bytes — the tool checks the claim, not the
69:  * history of the run; only `*.txt` files directly under --dir are receipts (subdirectories are not
70:  * walked, other suffixes are ignored); an external instrument whose named path is a symlink is
71:  * refused (SYMLINK_INSTRUMENT), never hashed through the link; `cmd=` tokens after the instrument
72:  * are not inspected; a `cmd=` whose second token is a flag rather than a program fails closed as
73:  * UNRESOLVED (it names no instrument).
74:  */
75: import { spawnSync } from 'node:child_process';
76: import { createHash } from 'node:crypto';
77: import {
78:   closeSync, constants as fsConstants, existsSync, fstatSync, lstatSync, mkdirSync, mkdtempSync,
79:   openSync, readFileSync, readdirSync, realpathSync, rmSync, symlinkSync, writeFileSync, writeSync,
80: } from 'node:fs';
81: import { tmpdir } from 'node:os';
82: import { basename, dirname, isAbsolute, join, relative, resolve, sep } from 'node:path';
83: import { fileURLToPath } from 'node:url';
84: 
85: const CONTRACT = 'kumitate-receipt-bind-v3';
86: const MAX_RECEIPT_BYTES = 1048576;
87: const SELF = fileURLToPath(import.meta.url);
88: const FULL_REV = /^[a-f0-9]{40}$/;
89: const FULL_SHA = /^[a-f0-9]{64}$/;
90: // A receipt is bound at a revision, so no inherited GIT_* override may redirect the read.
91: const GIT_ENV_DROP = [
92:   'GIT_DIR', 'GIT_WORK_TREE', 'GIT_INDEX_FILE', 'GIT_OBJECT_DIRECTORY', 'GIT_ALTERNATE_OBJECT_DIRECTORIES',
93:   'GIT_COMMON_DIR', 'GIT_NAMESPACE', 'GIT_PREFIX', 'GIT_CEILING_DIRECTORIES',
94: ];
95: 
96: const USAGE = `USAGE: node scripts/receipt-bind.mjs --dir <receipt-dir> --rev <40-hex> [--lane <dir>] [--json]
97:        node scripts/receipt-bind.mjs --selftest [--work <dir>]
98: 
99: Bind every *.txt close receipt under --dir to the instrument its own cmd= names.
100: contract ${CONTRACT}
101: 
102:   instrument   the SECOND whitespace token of cmd= (the program after the interpreter)
103:   digest       tool_sha256= of the receipt (a 64-hex sha256)
104:   rev          rev= of the receipt, else --rev (a per-receipt rev= overrides the default)
105:   --lane       repository the instruments are read from (default: this cwd's git toplevel)
106:   --json       one JSON object on stdout instead of the verdict line
107:   --selftest   hermetic fixtures under --work (its own git init repo); needs no lane
108: 
109: Lane-relative and lane-absolute instruments are hashed from git cat-file blob <rev>:<path>; an
110: absolute instrument outside the lane (judged on real paths) is hashed from the file on disk and
111: counted external=. A mode-120000 instrument at the rev, or a symlinked external instrument, is
112: fail-closed SYMLINK_INSTRUMENT. One leading UTF-8 BOM on a receipt is ignored.
113: 
114: exit 0   RECEIPT_BIND: CLEAN matched=<n> mismatched=0 unchecked=0 external=<e>
115: exit 1   RECEIPT_BIND: DRIFT matched=<n> mismatched=<m> unchecked=<u> external=<e> first=<file>
116: exit 2   RECEIPT_BIND: FAIL-CLOSED <TOKEN>[ detail]
117:          DIR_UNREADABLE SYMLINK_DIR SYMLINK_RECEIPT RECEIPT_UNREADABLE RECEIPT_TOO_LARGE AMBIGUOUS_FIELD
118:          SYMLINK_INSTRUMENT REV_UNRESOLVED UNRESOLVED ESCAPES_LANE LANE_UNREADABLE LANE_NOT_GIT INTERNAL
119: exit 64  usage
120: `;
121: 
122: function out(s) { writeSync(1, s); }
123: function errOut(s) { writeSync(2, s); }
124: 
125: function gitEnv(extra) {
126:   const env = { ...process.env, ...(extra || {}) };
127:   for (const k of GIT_ENV_DROP) delete env[k];
128:   env.GIT_TERMINAL_PROMPT = '0';
129:   return env;
130: }
131: 
132: function git(dir, args, opts) {
133:   const o = opts || {};
134:   return spawnSync('git', ['-C', dir, ...args], {
135:     encoding: o.buffer ? 'buffer' : 'utf8',
136:     maxBuffer: 64 << 20,
137:     timeout: 120000,
138:     env: gitEnv(o.env),
139:   });
140: }
141: 
142: const sha256 = (bytes) => createHash('sha256').update(bytes).digest('hex');
143: 
144: class FailClosed extends Error {
145:   constructor(token, detail) {
146:     super(token);
147:     this.token = token;
148:     this.detail = detail || '';
149:   }
150: }
151: 
152: // ---------------------------------------------------------------------------------------------
153: // arguments
154: 
155: function parseArgs(argv) {
156:   const args = { mode: 'bind', dir: null, rev: null, lane: null, json: false, work: null, help: false };
157:   const seen = new Set();
158:   const value = (i, flag) => {
159:     const v = argv[i + 1];
160:     if (v === undefined || v === '' || v.startsWith('-')) throw new Error(`${flag} needs a value`);
161:     return v;
162:   };
163:   for (let i = 0; i < argv.length; i += 1) {
164:     const a = argv[i];
165:     if (a === '-h' || a === '--help') { args.help = true; continue; }
166:     if (a === '--json' || a === '--selftest') {
167:       if (seen.has(a)) throw new Error(`${a} is given twice`);
168:       seen.add(a);
169:       if (a === '--json') args.json = true; else args.mode = 'selftest';
170:       continue;
171:     }
172:     if (!a.startsWith('-')) throw new Error(`unexpected argument: ${a}`);
173:     if (!['--dir', '--rev', '--lane', '--work'].includes(a)) throw new Error(`unknown argument: ${a}`);
174:     if (seen.has(a)) throw new Error(`${a} is given twice`);
175:     seen.add(a);
176:     const v = value(i, a);
177:     i += 1;
178:     if (a === '--dir') args.dir = v;
179:     else if (a === '--rev') args.rev = v;
180:     else if (a === '--lane') args.lane = v;
181:     else args.work = v;
182:   }
183:   return args;
184: }
185: 
186: // ---------------------------------------------------------------------------------------------
187: // binding
188: 
189: function defaultLane() {
190:   const r = spawnSync('git', ['rev-parse', '--show-toplevel'], {
191:     cwd: process.cwd(), encoding: 'utf8', timeout: 120000, env: gitEnv(),
192:   });
193:   const top = r.status === 0 ? r.stdout.trim() : '';
194:   return resolve(top || process.cwd());
195: }
196: 
197: /** Where an absolute path sits relative to the lane: inside (lane-relative), the root itself, or outside. */
198: function laneRel(lane, abs) {
199:   const rel = relative(lane, abs);
200:   if (rel === '') return { inside: true, root: true, rel: null };
201:   if (rel === '..' || rel.startsWith(`..${sep}`) || isAbsolute(rel)) return { inside: false, root: false, rel: null };
202:   return { inside: true, root: false, rel };
203: }
204: 
205: function revResolver(lane) {
206:   const cache = new Map();
207:   return (rev) => {
208:     if (cache.has(rev)) return cache.get(rev);
209:     const r = git(lane, ['rev-parse', '--verify', '--quiet', `${rev}^{commit}`]);
210:     const ok = r.status === 0;
211:     cache.set(rev, ok);
212:     return ok;
213:   };
214: }
215: 
216: function blobAt(lane, rev, rel) {
217:   const r = git(lane, ['cat-file', 'blob', `${rev}:${rel}`], { buffer: true });
218:   return r.status === 0 ? r.stdout : null;
219: }
220: 
221: function emitFailClosed(token, detail, json, extra) {
222:   if (json) {
223:     out(`${JSON.stringify({
224:       contract: CONTRACT, mode: 'bind', ok: false, verdict: 'FAIL-CLOSED', token, detail,
225:       findings: [{ kind: token, detail }], ...(extra || {}),
226:     })}\n`);
227:     return;
228:   }
229:   out(`RECEIPT_BIND: FAIL-CLOSED ${token}${detail ? ` ${detail}` : ''}\n`);
230: }
231: 
232: function bind({ dir, rev, laneArg, json }) {
233:   const lane = laneArg !== null ? resolve(laneArg) : defaultLane();
234:   let laneStat;
235:   try { laneStat = lstatSync(lane); } catch { throw new FailClosed('LANE_UNREADABLE', lane); }
236:   if (!laneStat.isDirectory()) throw new FailClosed('LANE_UNREADABLE', `${lane} is not a directory`);
237:   if (git(lane, ['rev-parse', '--git-dir']).status !== 0) throw new FailClosed('LANE_NOT_GIT', lane);
238:   // Lane membership is judged on REAL paths (v3): /proc/self/root<lane> is the lane itself.
239:   let laneReal = lane;
240:   try { laneReal = realpathSync(lane); } catch { /* keep the lexical path */ }
241: 
242:   // The default revision is judged before any receipt is read: a run whose default cannot be
243:   // resolved is fail-closed even when every receipt happens to carry its own rev= or an external
244:   // instrument, so "no receipts bound at this rev" can never be mistaken for a clean directory.
245:   const revOk = revResolver(lane);
246:   if (!revOk(rev)) throw new FailClosed('REV_UNRESOLVED', `--rev ${rev} is not a commit in ${lane}`);
247: 
248:   let entries;
249:   let dirStat;
250:   try { dirStat = lstatSync(dir); } catch (e) { throw new FailClosed('DIR_UNREADABLE', `${dir} (${e.code || 'unreadable'})`); }
251:   if (dirStat.isSymbolicLink()) throw new FailClosed('SYMLINK_DIR', dir);
252:   try { entries = readdirSync(dir); } catch (e) { throw new FailClosed('DIR_UNREADABLE', `${dir} (${e.code || 'unreadable'})`); }
253:   const files = entries.filter((f) => f.endsWith('.txt')).sort();
254: 
255:   let matched = 0;
256:   let mismatched = 0;
257:   let unchecked = 0;
258:   let external = 0;
259:   let first = null;
260:   const rows = [];
261: 
262:   for (const file of files) {
263:     const path = join(dir, file);
264:     let st;
265:     try { st = lstatSync(path); } catch (e) { throw new FailClosed('RECEIPT_UNREADABLE', `${path} (${e.code || 'lstat failed'})`); }
266:     if (st.isSymbolicLink()) throw new FailClosed('SYMLINK_RECEIPT', path);
267:     if (!st.isFile()) throw new FailClosed('RECEIPT_UNREADABLE', `${path} is not a regular file`);
268:     if (st.size > MAX_RECEIPT_BYTES) throw new FailClosed('RECEIPT_TOO_LARGE', `${path} is ${st.size} bytes (limit ${MAX_RECEIPT_BYTES})`);
269: 
270:     // Read from ONE descriptor (v3): the regular-file and size checks are re-asserted on the opened
271:     // file, so a path swapped between the lstat above and this read cannot substitute another file.
272:     let text;
273:     let fd = null;
274:     try {
275:       fd = openSync(path, fsConstants.O_RDONLY | fsConstants.O_NOFOLLOW);
276:       const fst = fstatSync(fd);
277:       if (!fst.isFile()) throw new FailClosed('RECEIPT_UNREADABLE', `${path} is not a regular file`);
278:       if (fst.size > MAX_RECEIPT_BYTES) {
279:         throw new FailClosed('RECEIPT_TOO_LARGE', `${path} is ${fst.size} bytes (limit ${MAX_RECEIPT_BYTES})`);
280:       }
281:       text = readFileSync(fd, 'utf8');
282:     } catch (e) {
283:       if (e instanceof FailClosed) throw e;
284:       throw new FailClosed('RECEIPT_UNREADABLE', `${path} (${e.code || 'read failed'})`);
285:     } finally {
286:       if (fd !== null) { try { closeSync(fd); } catch { /* already closed */ } }
287:     }
288:     // One leading UTF-8 BOM is a signature, not content (v3): it must not hide `rev=`.
289:     text = text.replace(/^\uFEFF/, '');
290:     const field = (key) => {
291:       const all = [...text.matchAll(new RegExp(`^${key}=(.*)$`, 'gm'))];
292:       if (all.length > 1) throw new FailClosed('AMBIGUOUS_FIELD', `${file} carries ${all.length} ${key}= lines`);
293:       return all.length ? all[0][1].trim() : null;
294:     };
295: 
296:     let receiptRev = rev;
297:     const revField = field('rev');
298:     if (revField !== null) {
299:       if (!FULL_REV.test(revField)) throw new FailClosed('REV_UNRESOLVED', `${file} rev=${JSON.stringify(revField)} is not 40 lowercase hex`);
300:       receiptRev = revField;
301:       if (!revOk(receiptRev)) throw new FailClosed('REV_UNRESOLVED', `${file} rev=${receiptRev} is not a commit in ${lane}`);
302:     }
303: 
304:     const cmdField = field('cmd');
305:     const digestField = field('tool_sha256');
306:     if (cmdField === null || digestField === null) {
307:       unchecked += 1;
308:       rows.push({ file, verdict: 'UNCHECKED', note: cmdField === null ? 'no cmd=' : 'no tool_sha256=' });
309:       if (first === null) first = file;
310:       continue;
311:     }
312:     const declared = digestField.toLowerCase();
313:     if (!FULL_SHA.test(declared)) {
314:       unchecked += 1;
315:       rows.push({ file, verdict: 'UNCHECKED', note: 'tool_sha256= is not a 64-hex sha256' });
316:       if (first === null) first = file;
317:       continue;
318:     }
319: 
320:     const toks = cmdField.split(/\s+/).filter((t) => t.length > 0);
321:     if (toks.length < 2) throw new FailClosed('UNRESOLVED', `${file} cmd= names no instrument: ${JSON.stringify(cmdField)}`);
322:     const instrument = toks[1];
323: 
324:     let rel = null;
325:     let abs = null;
326:     let fromDisk = false;
327:     if (isAbsolute(instrument)) {
328:       abs = resolve(instrument);
329:       // Membership on REAL paths (v3): an alias such as /proc/self/root<lane> is IN the lane even
330:       // though it is lexically outside it. Only the parent directory is resolved: the final component
331:       // is the instrument's own identity, so an in-lane SYMLINK named by the token stays a symlink
332:       // (SYMLINK_INSTRUMENT) instead of being followed to its target. A token whose parent is absent
333:       // on disk keeps the lexical judgement; the blob read decides.
334:       let absReal = null;
335:       try { absReal = join(realpathSync(dirname(abs)), basename(abs)); } catch { /* parent absent */ }
336:       const lr = absReal !== null ? laneRel(laneReal, absReal) : laneRel(lane, abs);
337:       if (lr.root) throw new FailClosed('UNRESOLVED', `${file} instrument names the lane root: ${instrument}`);
338:       if (lr.inside) rel = lr.rel; else fromDisk = true;
339:     } else {
340:       abs = resolve(lane, instrument);
341:       const lr = laneRel(lane, abs);
342:       if (lr.root) throw new FailClosed('UNRESOLVED', `${file} instrument resolves to the lane root: ${instrument}`);
343:       if (!lr.inside) throw new FailClosed('ESCAPES_LANE', `${file} relative instrument resolves outside the lane: ${instrument}`);
344:       rel = lr.rel;
345:     }
346: 
347:     let bytes;
348:     if (fromDisk) {
349:       // An external instrument named through a symlink is refused (v3): the link is what the
350:       // receipt named, and hashing through it would launder the target's identity.
351:       let est;
352:       try { est = lstatSync(abs); } catch (e) { throw new FailClosed('UNRESOLVED', `${file} external instrument unreadable: ${abs} (${e.code || 'lstat failed'})`); }
353:       if (est.isSymbolicLink()) throw new FailClosed('SYMLINK_INSTRUMENT', `${file} external instrument is a symlink: ${abs}`);
354:       try { bytes = readFileSync(abs); } catch (e) { throw new FailClosed('UNRESOLVED', `${file} external instrument unreadable: ${abs} (${e.code || 'read failed'})`); }
355:       external += 1;
356:     } else {
357:       // A mode-120000 instrument is a symlink (v3): `cat-file blob` returns its TARGET STRING, so
358:       // the digest would bind the link text while the executed content is the target's.
359:       const lsTree = git(lane, ['ls-tree', receiptRev, '--', rel]);
360:       const mode = lsTree.status === 0 ? (lsTree.stdout.trim().split(/\s+/)[0] || '') : '';
361:       if (mode === '120000') {
362:         throw new FailClosed('SYMLINK_INSTRUMENT', `${file} instrument is a symlink at ${receiptRev}: ${rel}`);
363:       }
364:       bytes = blobAt(lane, receiptRev, rel);
365:       if (bytes === null) throw new FailClosed('UNRESOLVED', `${file} instrument absent at ${receiptRev}: ${rel}`);
366:     }
367:     const computed = sha256(bytes);
368: 
369:     if (computed === declared) {
370:       matched += 1;
371:       rows.push({ file, verdict: 'MATCH', instrument, rev: receiptRev, source: fromDisk ? 'disk' : 'git', computed });
372:     } else {
373:       mismatched += 1;
374:       rows.push({ file, verdict: 'MISMATCH', instrument, rev: receiptRev, source: fromDisk ? 'disk' : 'git', declared, computed });
375:       if (first === null) first = file;
376:     }
377:   }
378: 
379:   const total = matched + mismatched + unchecked;
380:   const clean = total > 0 && mismatched === 0 && unchecked === 0;
381: 
382:   if (json) {
383:     out(`${JSON.stringify({
384:       contract: CONTRACT, mode: 'bind', ok: clean, verdict: clean ? 'CLEAN' : 'DRIFT',
385:       dir, rev, lane, receipts: files.length, matched, mismatched, unchecked, external,
386:       first: first === null ? null : first, rows,
387:     })}\n`);
388:   } else if (clean) {
389:     out(`RECEIPT_BIND: CLEAN matched=${matched} mismatched=0 unchecked=0 external=${external}\n`);
390:   } else {
391:     out(`RECEIPT_BIND: DRIFT matched=${matched} mismatched=${mismatched} unchecked=${unchecked} external=${external} first=${first === null ? '-' : first}\n`);
392:   }
393:   return clean ? 0 : 1;
394: }
395: 
396: // ---------------------------------------------------------------------------------------------
397: // selftest: hermetic — its own git init fixture repo under --work (or a private mkdtemp)
398: 
399: function selftest(workArg) {
400:   let root;
401:   if (workArg !== null) {
402:     const base = resolve(workArg);
403:     mkdirSync(base, { recursive: true });
404:     root = join(base, `receipt-bind-selftest-${process.pid}-${Math.random().toString(36).slice(2, 8)}`);
405:   } else {
406:     root = mkdtempSync(join(tmpdir(), 'receipt-bind-selftest-'));
407:   }
408:   mkdirSync(root, { recursive: true });
409:   try {
410:     return runSelftest(root);
411:   } finally {
412:     rmSync(root, { recursive: true, force: true });
413:   }
414: }
415: 
416: function runSelftest(root) {
417:   const repo = join(root, 'lane');
418:   const tmp = join(root, 'tmp');
419:   mkdirSync(repo, { recursive: true });
420:   mkdirSync(tmp, { recursive: true });
421:   const env = () => gitEnv({ TMPDIR: tmp });
422:   const g = (args, buffer) => git(repo, args, { buffer: !!buffer, env: { TMPDIR: tmp } });

SHA256 0ed30d4401b20d8954aef3c5b54107f7b8a1ee1b0f810deaba07e1fec73c90a4
1: #!/usr/bin/env python3
2: """souji-receipt-run.py — blob-bound receipts (round 23, C2).
3: 
4: A counter run is only evidence if the bytes that produced it are pinned. This runner
5: re-derives a command at a named, durable revision and writes a receipt that binds the
6: revision, the tool path, the tool's sha256 AT THAT REVISION, the command, its exit code and
7: its output. `verify` re-reads the same bytes from git and refuses a receipt whose recorded
8: digest is not the committed blob at the named revision.
9: 
10:   run    --root <repo> --rev <full40> --tool <repo-relative> --out <abs path> -- <cmd...>
11:   verify --root <repo> <receipt>
12: 
13: Receipt v1 header, in this order, then the two fences:
14: 
15:   receipt=v1
16:   rev=<40 hex>
17:   tool=<repo-relative path>
18:   tool_sha256=<64 hex>
19:   cmd=<shell-quoted argv>
20:   rc=<int>
21:   utc=<ISO 8601>
22:   --- stdout ---
23:   <verbatim>
24:   --- stderr ---
25:   <verbatim>
26: 
27: Refusals (exit 2, no receipt written): --rev not a full 40-hex id; --rev not reachable from
28: refs/heads, refs/tags or refs/remotes (refs/jj/* never counts — Q37); --tool absent at --rev;
29: --out under /tmp (Q4); --out outside the caller's scratch root, i.e. TMPDIR when it is set and
30: /var/tmp otherwise (OUT-OUTSIDE-SCRATCH, r24 W2Scope: the old guard let a receipt truncate fleet
31: files); --out inside --root (a receipt is not a repo write); --tool not an exact
32: element of the command argv (TOOL-NOT-IN-ARGV, the same predicate `verify` applies); a --tool path
33: that redaction would rewrite (TOOL-PATH-REDACTED); a command where a whole-line redaction pass
34: would still change the per-element-redacted line, i.e. a secret spanning argv elements
35: (CMD-SECRET-SHAPED, also any secret-shaped argument whose quoting a whole-line pass would
36: break); an argv element holding a newline or CR (CMD-NEWLINE); checked-out tool bytes that
37: differ from the committed blob, e.g. symlink/eol/ident (TOOL-CHECKOUT-DIFFERS). `cmd=` is shlex.join of the per-element-redacted argv, so every receipt
38: `run` writes parses under `verify`.
39: `verify` exits 2 with one of: RECEIPT-MALFORMED, RECEIPT-TOOL-DIGEST-MISMATCH,
40: RECEIPT-TOOL-ABSENT, RECEIPT-REV-MALFORMED, RECEIPT-COUNTS-ABSENT, RECEIPT-REV-NOT-DURABLE (the
41: same durable-ref predicate `run` refuses on), RECEIPT-TOOL-NOT-IN-ARGV (`tool=` is not an exact
42: element of shlex.split(cmd); `./tools/x` does not match `tools/x`); a `cmd=` that does not parse
43: as shell words is RECEIPT-MALFORMED. Argv membership binds the label to the recorded text, not to
44: the program that ran: `python3 tools/y.py tools/x.py` still verifies for tool=tools/x.py.
45: 
46: The measured tree is a private `--no-local` clone under the caller's scratch root (TMPDIR when
47: it is set, else /var/tmp), checked out detached at <rev>:
48: the runner never writes the source repository and never fetches from a remote. It is a counter
49: runner, not a sandbox and not a proof that the command is side-effect free — the receipt records
50: what ran.
51: 
52: Frozen contract: .ufo/waves/round-23/preregistration.txt (C2).
53: """
54: from __future__ import annotations
55: 
56: import argparse
57: import datetime as dt
58: import hashlib
59: import os
60: import re
61: import shlex
62: import shutil
63: import subprocess
64: import sys
65: 
66: sys.dont_write_bytecode = True
67: import tempfile
68: 
69: 
70: def scratch_root() -> str:
71:     """The caller's scratch root: TMPDIR when set, else /var/tmp (Q4: a receipt never goes to /tmp)."""
72:     return os.path.abspath(tempfile.gettempdir()) if os.environ.get("TMPDIR") else "/var/tmp"
73: 
74: 
75: def in_git_tree(path: str) -> bool:
76:     """True when `path` or one of its ancestors holds a `.git` entry."""
77:     p = path
78:     while True:
79:         if os.path.lexists(os.path.join(p, ".git")):
80:             return True
81:         parent = os.path.dirname(p)
82:         if parent == p:
83:             return False
84:         p = parent
85: 
86: 
87: COUNTS_RE = re.compile(
88:     r"(?:assertions=\d+ resolved=\d+ skipped=\d+ mismatches=\d+"
89:     r"|keys=\d+ records=\d+ occurrences=\d+ mismatches=\d+"
90:     r"|entries=\d+ ok=\d+.*?fail=\d+"
91:     r"|grounded=\d+ mapped=\d+ dangling=\d+ mismatches=\d+"
92:     r"|cases=\d+ pass=\d+"
93:     r"|garbage=\d+ size_garbage=\d+ unreachable=\d+ alternates=\d+"
94:     r"|selftest=(?:PASS|FAIL) ids=\d+/\d+)(?=\s|$)"
95: )
96: REV_RE = re.compile(r"^[0-9a-f]{40}$")
97: HEADER_ORDER = ("receipt", "rev", "tool", "tool_sha256", "cmd", "rc", "utc")
98: 
99: 
100: # ported from tools/souji-proc-census.sh redact_secrets: one convention, not a second one
101: REDACTIONS = (
102:     (re.compile(r"(?i)(authorization:\s*bearer\s+)\S+"), r"\1[REDACTED]"),
103:     (re.compile(r"(?i)(--token=)\S+"), r"\1[REDACTED]"),
104:     (re.compile(r"ghp_[A-Za-z0-9_-]+"), "[REDACTED]"),
105:     (re.compile(r"sk-[A-Za-z0-9_.-]+"), "[REDACTED]"),
106:     (re.compile(r"(?i)(password=)\S+"), r"\1[REDACTED]"),
107:     (re.compile(r"([A-Za-z][A-Za-z0-9.+-]*://)[^/@\s]*@"), r"\1[REDACTED]@"),
108:     (re.compile(r"AKIA[0-9A-Z]{16}"), "[REDACTED]"),
109:     (re.compile(r"xox[baprs]-[A-Za-z0-9_.-]+"), "[REDACTED]"),
110: )
111: CTRL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")
112: 
113: 
114: def counts_line(stdout: str) -> str | None:
115:     """The last stdout line that STARTS with a counts line (anchored; stderr and prose never count)."""
116:     for line in reversed(stdout.splitlines()):
117:         match = COUNTS_RE.match(line)
118:         if match:
119:             return match.group(0)
120:     return None
121: 
122: 
123: def redact(text: str) -> str:
124:     """Redact secret-shaped spans. Not a proof that the output is secret-free."""
125:     out = CTRL_RE.sub(" ", text)
126:     for pattern, repl in REDACTIONS:
127:         out = pattern.sub(repl, out)
128:     return out
129: 
130: 
131: DENY_SUBCOMMANDS = {
132:     "fsck-lost-found", "gc", "prune", "repack", "fetch", "push", "pull", "clean",
133:     "checkout", "reset", "restore", "switch", "filter-branch", "lost-found",
134: }
135: 
136: 
137: def command_refusal(argv: list[str]) -> str | None:
138:     """Refuse the measured command shapes that would defeat the scratch cwd."""
139:     if not argv:
140:         return None
141:     if os.path.basename(argv[0]) != "git":
142:         return None
143:     if "-C" in argv or "--git-dir" in argv or "--work-tree" in argv:
144:         return "GIT-DIRECTED-COMMAND: a -C/--git-dir/--work-tree command escapes the measured tree"
145:     if "--lost-found" in argv:
146:         return "WRITE-SIDE-EFFECT: git fsck --lost-found writes into the repository"
147:     # every token, not only the first non-dash one: `git -c k=v gc` must not slip through
148:     for token in argv[1:]:
149:         if token in DENY_SUBCOMMANDS:
150:             return f"MUTATING-SUBCOMMAND: git {token} is not a counter"
151:     return None
152: 
153: 
154: def git(root: str, *args: str) -> subprocess.CompletedProcess:
155:     env = {k: v for k, v in os.environ.items() if k not in ("GIT_DIR", "GIT_WORK_TREE")}
156:     env["GIT_CONFIG_COUNT"] = "1"
157:     env["GIT_CONFIG_KEY_0"] = "core.fsmonitor"
158:     env["GIT_CONFIG_VALUE_0"] = "false"
159:     env["GIT_NO_REPLACE_OBJECTS"] = "1"
160:     env["GIT_NO_LAZY_FETCH"] = "1"
161:     return subprocess.run(["git", "-C", root, "-c", "maintenance.auto=false", *args],
162:                           capture_output=True, text=True, env=env)
163: 
164: 
165: def refuse(code: str, detail: str) -> int:
166:     print(f"{code}\t{detail}", file=sys.stderr)
167:     return 2
168: 
169: 
170: def durable_rev(root: str, rev: str) -> bool:
171:     """True when rev is a commit reachable from a durable ref (never refs/jj/*)."""
172:     proc = git(root, "for-each-ref", "--format=%(refname)", "--contains", rev,
173:                "refs/heads", "refs/tags", "refs/remotes")
174:     return proc.returncode == 0 and bool(proc.stdout.strip())
175: 
176: 
177: def blob_sha_bytes(root: str, rev: str, path: str) -> str | None:
178:     env = {k: v for k, v in os.environ.items() if k not in ("GIT_DIR", "GIT_WORK_TREE")}
179:     env["GIT_NO_REPLACE_OBJECTS"] = "1"
180:     env["GIT_NO_LAZY_FETCH"] = "1"
181:     proc = subprocess.run(["git", "-C", root, "-c", "maintenance.auto=false",
182:                            "cat-file", "blob", f"{rev}:{path}"],
183:                           capture_output=True, env=env)
184:     if proc.returncode != 0:
185:         return None
186:     return hashlib.sha256(proc.stdout).hexdigest()
187: 
188: 
189: def cmd_run(args: argparse.Namespace) -> int:
190:     root = os.path.abspath(args.root)
191:     rev = args.rev
192:     if not REV_RE.match(rev or ""):
193:         return refuse("REV-MALFORMED", "--rev must be a full 40-hex commit id")
194:     if git(root, "cat-file", "-e", f"{rev}^{{commit}}").returncode != 0:
195:         return refuse("REV-ABSENT", f"no commit {rev}")
196:     if not durable_rev(root, rev):
197:         return refuse("REV-NOT-DURABLE", f"{rev} is not reachable from refs/heads|tags|remotes")
198:     tool = args.tool
199:     if blob_sha_bytes(root, rev, tool) is None:
200:         return refuse("TOOL-ABSENT", f"{tool} does not exist at {rev}")
201:     out = os.path.realpath(args.out)
202:     if out.startswith("/tmp/") or out == "/tmp":
203:         return refuse("OUT-UNDER-TMP", "receipts go outside /tmp (Q4)")
204:     base_scratch = os.path.realpath(scratch_root())
205:     if out == base_scratch or not out.startswith(base_scratch + os.sep):
206:         return refuse("OUT-OUTSIDE-SCRATCH",
207:                       f"receipts are written under the caller's scratch root ({base_scratch}) "
208:                       "and copied into the lane by its helper")
209:     if out == root or out.startswith(root + os.sep):
210:         return refuse("OUT-IN-REPO", "the receipt must not be written inside the measured repo")
211:     if not args.command:
212:         return refuse("COMMAND-ABSENT", "nothing to run after --")
213:     why = command_refusal(args.command)
214:     if why:
215:         return refuse(why.split(":", 1)[0], why.split(":", 1)[1].strip())
216:     if tool not in args.command:
217:         return refuse("TOOL-NOT-IN-ARGV", f"{tool} is not an argv element of the command")
218:     if redact(tool) != tool:
219:         return refuse("TOOL-PATH-REDACTED", "the tool path would be rewritten by redaction")
220:     if any("\n" in a or "\r" in a for a in args.command):
221:         return refuse("CMD-NEWLINE", "an argv element holds a newline; it would split the receipt header")
222:     cmd_line = shlex.join([redact(a) for a in args.command])
223:     if (redact(" ".join(args.command)) != " ".join(redact(a) for a in args.command)
224:             or redact(cmd_line) != cmd_line):
225:         return refuse("CMD-SECRET-SHAPED",
226:                       "a secret-shaped argument would leak across argv elements or leave cmd= unparsable; such commands get no receipt")
227:     for protected in ("/.ufo/state/", "/.tower/", "/.scratch/", "/MANIFEST.json"):
228:         if protected in out:
229:             return refuse("OUT-PROTECTED", f"{protected} is operator or orchestrator runtime")
230:     if re.search(r"/[A-Za-z0-9_-]+-shokunin/", out) and not out.startswith(root + os.sep):
231:         return refuse("OUT-SIBLING-LANE", "a receipt is never written into another lane")
232:     # r32 wave a2w1 SwarmReviewer13: a caller-set TMPDIR must not re-open the write scope that the
233:     # fixed /var/tmp root closed, so with TMPDIR set neither the root nor the receipt may sit in a work tree
234:     if os.environ.get("TMPDIR") and (in_git_tree(base_scratch) or in_git_tree(os.path.dirname(out))):
235:         return refuse("OUT-IN-GIT-TREE",
236:                       "with TMPDIR set, neither the scratch root nor the receipt may lie inside a git work tree")
237: 
238:     scratch = tempfile.mkdtemp(prefix="souji-receipt-", dir=scratch_root())
239:     tree = os.path.join(scratch, "repo")
240:     try:
241:         # a private local clone: the measured tree is a real repository at <rev>, so a counter
242:         # that needs git plumbing works, and the source repo is only read
243:         clone = subprocess.run(["git", "clone", "--quiet", "--no-local", "--no-checkout",
244:                                 root, tree], capture_output=True, text=True)
245:         if clone.returncode != 0:
246:             return refuse("CLONE-FAILED", clone.stderr.strip())
247:         # sparse-checkout: the lane's operator-sweep blob tree is bound materialized in the clone
248:         # (W2Bounds F1) — the receipt run must not copy those contents, even transiently
249:         sp = subprocess.run(["git", "-C", tree, "-c", "maintenance.auto=false",
250:                              "sparse-checkout", "init", "--no-cone"],
251:                             capture_output=True, text=True)
252:         if sp.returncode != 0:
253:             return refuse("SPARSE-INIT-FAILED", sp.stderr.strip())
254:         with open(os.path.join(tree, ".git", "info", "sparse-checkout"), "w") as fh:
255:             fh.write("/*")
256:             fh.write(chr(10))
257:             fh.write("!/census/operator-sweep-*")
258:             fh.write(chr(10))
259: 
260:         co = subprocess.run(["git", "-C", tree, "-c", "maintenance.auto=false",
261:                              "checkout", "--quiet", "--detach", rev],
262:                             capture_output=True, text=True)
263:         if co.returncode != 0:
264:             return refuse("CHECKOUT-FAILED", co.stderr.strip())
265:         run_env = {k: v for k, v in os.environ.items()
266:                    if k not in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE")}
267:         run_env["GIT_OPTIONAL_LOCKS"] = "0"
268:         run_env["GIT_NO_REPLACE_OBJECTS"] = "1"
269:         run_env["GIT_NO_LAZY_FETCH"] = "1"
270:         # the digest is taken from the tree the command runs in, never from a second read of
271:         # the source repo (a refs/replace ref makes the two disagree)
272:         try:
273:             with open(os.path.join(tree, tool), "rb") as fh:
274:                 digest = hashlib.sha256(fh.read()).hexdigest()
275:         except OSError as exc:
276:             return refuse("TOOL-UNREADABLE", f"{tool} in the measured tree: {exc}")
277:         # verify hashes the committed blob; a symlink, eol or ident checkout would make the
278:         # receipt unverifiable, so run refuses instead of writing it
279:         if os.path.islink(os.path.join(tree, tool)) or digest != blob_sha_bytes(tree, rev, tool):
280:             return refuse("TOOL-CHECKOUT-DIFFERS",
281:                           f"{tool}: checked-out bytes differ from the committed blob at {rev}")
282:         # errors="replace": a non-UTF-8 byte must produce a receipt with a recorded
283:         # replacement, not an exception that leaves no evidence at all
284:         proc = subprocess.run(args.command, cwd=tree, capture_output=True, text=True,
285:                               errors="replace", env=run_env)
286:     finally:
287:         shutil.rmtree(scratch, ignore_errors=True)
288: 
289:     lines = [
290:         "receipt=v1",
291:         f"rev={rev}",
292:         f"tool={tool}",
293:         f"tool_sha256={digest}",
294:         f"cmd={cmd_line}",
295:         f"rc={proc.returncode}",
296:         f"utc={dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}",
297:         "--- stdout ---",
298:         redact(proc.stdout.rstrip("\n")),
299:         "--- stderr ---",
300:         redact(proc.stderr.rstrip("\n")),
301:     ]
302:     body = "\n".join(lines) + "\n"
303:     os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
304:     with open(out, "w", encoding="utf-8") as fh:
305:         fh.write(body)
306:     counts = counts_line(redact(proc.stdout.rstrip("\n")))
307:     print(f"receipt={out} rev={rev} tool_sha256={digest} rc={proc.returncode} "
308:           f"counts={counts or 'none'}")
309:     return 0
310: 
311: 
312: def parse_receipt(text: str) -> dict[str, str] | None:
313:     lines = text.splitlines()
314:     if not lines or lines[0] != "receipt=v1":
315:         return None
316:     header: dict[str, str] = {}
317:     idx = 0
318:     for name in HEADER_ORDER:
319:         if idx >= len(lines) or not lines[idx].startswith(name + "="):
320:             return None
321:         header[name] = lines[idx].split("=", 1)[1]
322:         idx += 1
323:     if idx >= len(lines) or lines[idx] != "--- stdout ---":
324:         return None
325:     header["_body"] = "\n".join(lines[idx:])
326:     try:
327:         end = lines.index("--- stderr ---", idx + 1)
328:     except ValueError:
329:         return None
330:     header["_stdout"] = "\n".join(lines[idx + 1:end])
331:     return header
332: 
333: 
334: def cmd_verify(args: argparse.Namespace) -> int:
335:     root = os.path.abspath(args.root)
336:     try:
337:         with open(args.receipt, encoding="utf-8") as fh:
338:             text = fh.read()
339:     except OSError as exc:
340:         return refuse("RECEIPT-UNREADABLE", str(exc))
341:     header = parse_receipt(text)
342:     if header is None:
343:         return refuse("RECEIPT-MALFORMED", "header order or fences do not match receipt v1")
344:     rev = header["rev"]
345:     if not REV_RE.match(rev):
346:         return refuse("RECEIPT-REV-MALFORMED", f"rev={rev!r}")
347:     tool = header["tool"]
348:     actual = blob_sha_bytes(root, rev, tool)
349:     if actual is None:
350:         return refuse("RECEIPT-TOOL-ABSENT", f"{tool} absent at {rev}")
351:     if actual != header["tool_sha256"]:
352:         return refuse("RECEIPT-TOOL-DIGEST-MISMATCH",
353:                       f"receipt {header['tool_sha256'][:12]} != tree {actual[:12]} at {rev}")
354:     if counts_line(header["_stdout"]) is None:
355:         return refuse("RECEIPT-COUNTS-ABSENT", "no stdout line starts with a counts line")
356:     if not durable_rev(root, rev):
357:         return refuse("RECEIPT-REV-NOT-DURABLE",
358:                       f"{rev} is not reachable from refs/heads|tags|remotes")
359:     try:
360:         argv = shlex.split(header["cmd"])
361:     except ValueError as exc:
362:         return refuse("RECEIPT-MALFORMED", f"cmd= does not parse as shell words: {exc}")
363:     why = command_refusal(argv)
364:     if why:
365:         return refuse("RECEIPT-COMMAND-REFUSED", why)
366:     if tool not in argv:
367:         return refuse("RECEIPT-TOOL-NOT-IN-ARGV", f"{tool} is not an argv element of cmd=")
368:     print(f"verify=ok rev={rev} tool={tool} tool_sha256={actual}")
369:     return 0
370: 
371: 
372: def main(argv: list[str]) -> int:
373:     ap = argparse.ArgumentParser(description="souji blob-bound receipt runner (C2)")
374:     sub = ap.add_subparsers(dest="mode", required=True)
375:     r = sub.add_parser("run")
376:     r.add_argument("--root", default=os.getcwd())
377:     r.add_argument("--rev", required=True)
378:     r.add_argument("--tool", required=True)
379:     r.add_argument("--out", required=True)
380:     r.add_argument("command", nargs=argparse.REMAINDER)
381:     v = sub.add_parser("verify")
382:     v.add_argument("--root", default=os.getcwd())
383:     v.add_argument("receipt")
384:     args = ap.parse_args(argv)
385:     if args.mode == "run":
386:         cmd = list(args.command)
387:         if cmd and cmd[0] == "--":
388:             cmd = cmd[1:]
389:         args.command = cmd
390:         return cmd_run(args)
391:     return cmd_verify(args)
392: 
393: 
394: if __name__ == "__main__":
395:     sys.exit(main(sys.argv[1:]))

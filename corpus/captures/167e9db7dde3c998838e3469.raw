	align-items: stretch;
}
main .list-layout>.marker{
	/** Text **/
	white-space: nowrap;
}
main .list-layout>.text{
	/** Basic Box Model **/
	margin: 0 0 0 .5em;
}
.row h1,
.side-nav,
.side-nav h1,
.main-cont,
.main-cont h2,
.main-cont h3,
.main-cont h4{
	/** Fonts **/
	font-family: Meiryo!important;
}
.row h1{
	/** Basic Box Model **/
	margin:0 0 0 40px 10px;
	/** Fonts **/
	font-size: 20px;
	font-weight: bold;
	/** Line **/
	line-height: 25px;
}
.row p{
	margin:0 0 0 0 10px;

}
.side-nav{
	/** Text **/
	white-space: nowrap;
}
.side-nav h1{
	/** Fonts **/
	font-size: 14px;
	font-weight: bold;
	/** Line **/
	line-height: 20px;
}
.main-cont h2{
	/** Basic Box Model **/
	margin: 10px 0 25px;
	/** Fonts **/
	font-size: 18px;
	font-weight: bold;
	/** Line **/
	line-height: 25px;
}
.main-cont h3{
	/** Basic Box Model **/
	margin: 23px 0;
	/** Fonts **/
	font-size: 16px;
	font-weight: bold;
	/** Line **/
	line-height: 23px;
}
.main-cont h4{
	/** Basic Box Model **/
	margin: 20px 0;
	/** Fonts **/
	font-size: 14px;
	font-weight: bold;
	/** Line **/
	line-height: 20px;
}
.main-cont p,
.main-cont ul{
	/** Basic Box Model **/
	margin: 10px 0;
	padding: 0 0 0 15px;
	/** Fonts **/
	font-size: 14px;
	/** Line **/
	line-height: 20px;
}
.main-cont small{
	/** Fonts **/
	font-size: 12px;
}
.main-cont sup{
	/** Fonts **/
	font-size: 10px;
}
.main-cont table{
	/** Basic Box Model **/
	width: 100%;
	margin: 10px 0;
	/** Fonts **/
	font-size: 13px;
	/** Line **/
	line-height: 20px;
}
.main-cont th,
.main-cont td{
	/** Background and Borders **/
	border: 1px solid #ddd;
	/** Basic Box Model **/
	padding: 10px;
	/** Line **/
	vertical-align: middle;
}
.main-cont th{
	/** Background and Borders **/
	background: #edeeef;
	/** Text **/
	text-align: center;
}
.main-cont td{
	/** Background and Borders **/
	background: #ffffff;
}
.main-cont .col1,
.main-cont .col2,
.main-cont .col4{
	/** Text **/
	white-space: nowrap;
}
.layout1{
	/** Basic Box Model **/
	margin: 0;
	padding: 0;
}
.layout1>li{
	/** Background and Borders **/
	border-top: 1px solid #cccccc;
	/** Basic Box Model **/
	padding: 12px 0;
}
.layout1>li:first-child{
	/** Background and Borders **/
	border-top: none;
	/** Basic Box Model **/
	padding-top: 2px;
}
ul.chuten>li{
	/** Positioned Layout **/
	position: relative;
	/** Basic Box Model **/
	margin: 0 0 0 18px;
	/** Positioned Layout **/
	position: relative;
	/** Basic Box Model **/
	margin-left: 18px;
	/** Fonts **/
	font-size: 14px;
}
ul.chuten>li::before{
	/** Positioned Layout **/
	position: absolute;
	top: 0;
	left: -16px;
	/** Basic Box Model **/
	display: block;
	/** Generated and Rplaced Content **/
	content: '・';
}
ul.chuten>li>p{
	/** Basic Box Model **/
	margin: 0;
	padding: 0;
}
ul.hyphen>li{
	/** Positioned Layout **/
	position: relative;
	/** Basic Box Model **/
	margin: 0 0 0 13px;
	/** Positioned Layout **/
	position: relative;
	/** Basic Box Model **/
	margin-left: 18px;
	/** Fonts **/
	font-size: 14px;
}
ul.hyphen>li::before{
	/** Positioned Layout **/
	position: absolute;
	top: 0;
	left: -11px;
	/** Basic Box Model **/
	display: block;
	/** Generated and Rplaced Content **/
	content: '-';
}
ul.hyphen>li>p{
	/** Basic Box Model **/
	margin: 0;
	padding: 0;
}
img.thumb{
	/** Background and Borders **/
	border: 1px solid #DCDCDC;
	/** Basic Box Model **/
	margin: 10px;
}

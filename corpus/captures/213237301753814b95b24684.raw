\n        events.push(eventData);\n        window.localStorage.setItem(connectAppAnalytics, JSON.stringify(events));\n      }\n    });\n\n  }());\n\u003C\u002Fscript\u003E\n\n\u003C\u002Fdiv\u003E\n","location":"atl.general","label":"Aura Admin Modal","weight":100,"name":"Aura Admin Modal"},"client:root:webPanels(contentId:\"355862667\",location:\"atl.footer\"):0":{"__id":"client:root:webPanels(contentId:\"355862667\",location:\"atl.footer\"):0","__typename":"WebPanel","moduleKey":"create-dialog-init-params","completeKey":"com.atlassian.confluence.plugins.confluence-create-content-plugin:create-dialog-init-params","html":"","location":"atl.footer","label":null,"weight":1000,"name":null},"client:Content:355862667:links":{"__id":"client:Content:355862667:links","__typename":"LinksDownloadEdituiWebuiContextSelfTinyuiCollectionBase","webui":"\u002Fspaces\u002FMANUAL\u002Fpages\u002F355862667\u002F10.2.2+Developing+your+protocol","base":"https:\u002F\u002Fjbi-global.atlassian.net\u002Fwiki"},"client:Content:355862667:properties(keys:[\"emoji-title-published\",\"editor\"])":{"__id":"client:Content:355862667:properties(keys:[\"emoji-title-published\",\"editor\"])","__typename":"PaginatedJsonContentPropertyList","nodes":{"__refs":["client:Content:355862667:properties(keys:[\"emoji-title-published\",\"editor\"]):nodes:0"]}},"client:Content:355862667:properties(keys:[\"emoji-title-published\",\"editor\"]):nodes:0":{"__id":"client:Content:355862667:properties(keys:[\"emoji-title-published\",\"editor\"]):nodes:0","__typename":"JsonContentProperty","value":"\"v2\"","key":"editor"},"ConfluenceForgeExtension:ari:cloud:ecosystem::extension\u002F3ac83948-9c34-4d83-9fe6-2ed4fc7e0c6a\u002F01eded08-88ed-4438-b8cc-dd19a8224151\u002Fstatic\u002Fflowchart":{"__id":"ConfluenceForgeExtension:ari:cloud:ecosystem::extension\u002F3ac83948-9c34-4d83-9fe6-2ed4fc7e0c6a\u002F01eded08-88ed-4438-b8cc-dd19a8224151\u002Fstatic\u002Fflowchart","__typename":"ConfluenceForgeExtension","id":"ari:cloud:eco
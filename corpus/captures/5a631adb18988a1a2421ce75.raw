<script>
    const offsetFromUTC = Math.floor(new Date().getTimezoneOffset() / 60);
    const offsetFromPuntaCana = offsetFromUTC+1;
    const originalHours = $('.event-time').map(function() {
        return [$(this).text().trim().split(/:|-/)];
    });

    $('input:radio[name=timezone]').on('change', function (){
        $('.event-time').each(
            function(index){
                if ($(this).text().trim() !== '') {
                    const times = originalHours[index];
                    let offset;
                    if ($('#timezone-local').is(":checked"))
                        offset = offsetFromPuntaCana;
                    else
                        offset = 0;
                    let hour1 = parseInt(times[0]) - offset;
                    let hour2 = parseInt(times[2]) - offset;
                    $(this).text(hour1 + ':' + times[1] + '-' + hour2 + ':' + times[3]);
                }
            })
        }
    );
</script>






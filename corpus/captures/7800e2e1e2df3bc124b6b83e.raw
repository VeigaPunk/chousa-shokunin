{"created": "2021-06-11T11:53:07.988754+00:00", "modified": "2021-06-11T13:48:24.048451+00:00", "id": 4925954, "conceptrecid": "4925953", "doi": "10.5281/zenodo.4925954", "conceptdoi": "10.5281/zenodo.4925953", "doi_url": "https://doi.org/10.5281/zenodo.4925954", "metadata": {"title": "FEVER: Fact Extraction and VERification", "doi": "10.5281/zenodo.4925954", "publication_date": "2018-04-03", "description": "<p>FEVER (Fact Extraction and VERification) consists of 185,445 claims generated by altering sentences extracted from Wikipedia and subsequently verified without knowledge of the sentence they were derived from. The claims are classified as&nbsp;<strong>Supported</strong>,&nbsp;<strong>Refuted</strong>&nbsp;or&nbsp;<strong>NotEnoughInfo</strong>. For the first two classes, the annotators also recorded the sentence(s) forming the necessary evidence for their judgment.</p>", "access_right": "open", "creators": [{"name": "Thorne, James", "affiliation": "University of Cambridge"}, {"name": "Vlachos, Andreas", "affiliation": "University of Cambridge", "orcid": "0000-0003-2123-5071"}, {"name": "Christodoulopoulos, Christos", "affiliation": "Amazon Alexa", "orcid": "0000-0001-7708-0051"}, {"name": "Mittal, Arpit", "affiliation": "Facebook"}], "keywords": ["fact verification", "natural language processing", "machine learning"], "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-sa-3.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "4925953"}}]}}, "title": "FEVER: Fact Extraction and VERification", "links": {"self": "https://zenodo.org/api/records/4925954", "self_html": "https://zenodo.org/records/4925954", "preview_html": "https://zenodo.org/records/4925954?preview=1", "doi": "https://doi.org/10.5281/zenodo.4925954", "self_doi": "https://doi.org/10.5281/zenodo.4925954", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.4925954", "reserve_doi": "https://zenodo.org/api/records/4
<script>
  (function (){
  // select and hide form block, hide current url info-box
    let feedback_form = document.querySelector('#feedback__form'),
    feedback_form_url = document.querySelector('.form-item-angaende-url'),
    submitButton = document.querySelector('#feedback__form form'),
    feedbackYes = document.querySelector('.feedback-button__yes'),
    feedbackNo = document.querySelector('.feedback-button__no'),
    thumb = document.querySelector("[name='thumb_up_or_down']");
    feedbackValue = '';
    const formSubmitButton = document.querySelector('#edit-actions-submit');

    if (formSubmitButton) { // Check if the element exists
      submitButton.disabled = true;
      //Use the hidden name field to detect if a bot is trying to submit form
      formSubmitButton.addEventListener('click', () => {
        if(document.querySelector('#edit-ditt-namn-frivilligt-').value) {
        event.preventDefault();
      }
    });
    } else {
      // Optional: Handle the case where the submit button is not found
      console.log('Submit button with ID "edit-submit" not found.');
    }



    if (feedback_form) {
      feedback_form.setAttribute('hidden', true);
    }
    if (feedback_form_url) {
      feedback_form_url.setAttribute('hidden', true);
    }

  // detect click on inputs, show form, toggle opacity and clr on icons, set feeback value
  const feedbackButton = document.querySelectorAll('.feedback-button'),
  showFeedbackForm = (e) => {
    feedback_form.removeAttribute('hidden');
    if (formSubmitButton) {
      formSubmitButton.disabled = false;
    }
    feedback_form.classList.add('form-is-open');

    //Hide the name field
    document.querySelector('.form-item-ditt-namn-frivilligt-').style.display = "none";

    if (e.target.classList.contains('feedback-button__yes')) {
      feedbackNo.classList.add('faded');
      feedbackNo.classList.remove('feedback-button__no_active');
      e.target.classList.remove('faded');
      e.target.classList.add('feedback-button__yes_active');
      feedbackValue = 'good!';
      thumb.value = 'positive';
      if (window._paq) {
         _paq.push(['trackEvent', 'Feedback', thumb.value, window.location.href]);
      }
    }
    if (e.target.classList.contains('feedback-button__no')) {
      feedbackYes.classList.add('faded');
      feedbackYes.classList.remove('feedback-button__yes_active');
      e.target.classList.remove('faded');
      e.target.classList.add('feedback-button__no_active');
      feedbackValue = 'bad!';
      thumb.value = 'negative';
      if (window._paq) {
         _paq.push(['trackEvent', 'Feedback', thumb.value, window.location.href]);
      }
    }

  }

  feedbackButton.forEach((item) => {
    item.addEventListener('click', showFeedbackForm)
  });
})();

</script>


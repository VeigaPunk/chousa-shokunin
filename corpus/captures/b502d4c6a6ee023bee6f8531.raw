<td id="S5.T6.2.3.2" class="ltx_td ltx_align_center ltx_border_t">38.85</td>
<td id="S5.T6.2.3.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">40.45</td></tr>
<tr id="S5.T6.2.4" class="ltx_tr">

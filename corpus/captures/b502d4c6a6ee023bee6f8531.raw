<th id="S5.T6.2.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt" rowspan="2"><span id="S5.T6.2.1.1.1" class="ltx_text ltx_font_bold">Model</span></th>

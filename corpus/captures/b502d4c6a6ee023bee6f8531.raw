<th id="S5.T2.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.2.1.2.1" class="ltx_text ltx_font_bold">Fully</span></th>
<th id="S5.T2.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.2.1.3.1" class="ltx_text ltx_font_bold">Oracle</span></th></tr>

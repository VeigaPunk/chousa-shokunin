<script>
    var id = '1126';
    new Vue({
        el: '#app',
        data(){
            return {
                id: id,
                submitBtnLoading: false,
            }
        },
        created(){
            this.initHits();
            this.initVideo();
        },
        mounted(){
        },
        methods: {
            initHits(){
                if(!this.id){
                    return false;
                }
                $.ajax({
                    url:'/api/?r=site/hits',
                    dataType:'json',
                    type:'get',
                    data:{
                        id: this.id,
                        is_hidden: 1,
                    },
                    success:(res)=>{
                    }
                });
            },
            initVideo(){
                if(!this.id){
                    return false;
                }
                $.ajax({
                    url:'/api/?r=site/video',
                    dataType:'json',
                    type:'post',
                    data:{
                        id: this.id,
                    },
                    success:(res)=>{
                        if(res.data){
                            const player = new Aliplayer({
                                    "id": "player-con",
                                    "vid": res.data.videoid,
                                    "playauth": res.data.playAuth,
                                    "qualitySort": "asc",
                                    "format": res.data.format,
                                    "mediaType": "video",
                                    "width": "100%",
                                    "height": "500px",
                                    "autoplay": true,
                                    "isLive": false,
                                    "rePlay": false,
                                    "playsinline": true,
                                    "preload": true,
                                    "controlBarVisibility": "hover",
                                    "useH5Prism": true,
                                }, function (player) {
                                    console.log("The player is created");
                                }
                            );
                        }
                    }
                });

            }
        }
    });
</script>


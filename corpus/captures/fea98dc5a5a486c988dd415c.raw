main .list-layout{
	/** Basic Box Model **/
	display: flex!important;
	/** Flexible Box Layout **/
	flex-flow: row nowrap;
	justify-content: flex-start;
	align-items: stretch;
}
main .list-layout>.marker{
	/** Text **/
	white-space: nowrap;
}
main .list-layout>.text{
	/** Text **/
	white-space: inherit;
}
main h1,
.side-nav,
.main-cont,
.main-cont h2,
.main-cont h3,
.main-cont h4{
	/** Fonts **/
	font-family: Meiryo!important;
}
.side-nav{
	/** Text **/
	white-space: nowrap;
}
.side-nav ol.glist{
	/** Basic Box Model **/
	margin: 0;
}
.side-nav ol.glist>li{
	/** Basic Box Model **/
	margin: 0;
	/** Fonts **/
	font-size: 14px;
	/** Line **/
	line-height: 20px;
}
.side-nav ol.glist>li:not(:first-child){
	/** Basic Box Model **/
	margin-top: 10px;
}
.side-nav ol.glist>li>a{
	/** Color **/
	color: #0066cc;
}
main h1{
	/** Basic Box Model **/
	margin: 0 0 18px;
	/** Fonts **/
	font-size: 20px;
	font-weight: bold;
	/** Line **/
	line-height: 25px;
}
.main-cont h2{
	/** Background and Borders **/
	background: #0050a0;
	border: 0 none #0050a0;
	border-top: 1px solid #cccccc;
	border-bottom: 1px solid #cccccc;
	/** Basic Box Model **/
	padding: 6.5px 10px;
	/** Color **/
	color: #ffffff;
	/** Fonts **/
	font-size: 18px;
	font-weight: bold;
	/** Line **/
	line-height: 20px;
}
.main-cont h3{
	/** Background and Borders **/
	background: #cccccc;
	border: 0 none #cccccc;
	/** Basic Box Model **/
	padding: 5px 10px;
	/** Color **/
	color: #000000;
	/** Fonts **/
	font-size: 16px;
	font-weight: bold;
	/** Line **/
	line-height: 20px;
}
.main-cont h4{
	/** Background and Borders **/
	background: #eaeaea;
	border: 0 none #eaeaea;
	border-bottom: 1px solid #cccccc;
	/** Basic Box Model **/
	padding: 5px 10px;
	/** Color **/
	color: #000000;
	/** Fonts **/
	font-size: 14px;
	font-weight: bold;
	/** Line **/
	line-height: 20px;
}
.main-cont ol.level1{
	/** Basic Box Model **/
	margin: 0;
	padding: 0;
}
.main-cont ol.level1>li{
	/** Basic Box Model **/
	margin: 23px 0 0;
	padding: 12px 0 0;
}
.main-cont ol.level1>li:first-child{
	/** Basic Box Model **/
	margin-top: 0;
}
.main-cont ol.level2{
	/** Basic Box Model **/
	margin: 0;
	padding: 0;
}
.main-cont ol.level2>li{
	/** Basic Box Model **/
	margin: 9px 0 0;
	padding: 0;
}
.main-cont ol.level3{
	/** Basic Box Model **/
	margin: 0;
	padding: 0;
}
.main-cont ol.level3>li{
	/** Basic Box Model **/
	margin: 7px 0 0;
	padding: 0;
}
.main-cont,
.main-cont .qa-list p,
.main-cont .qa-list li{
	/** Fonts **/
	font-size: 14px;
	/** Line **/
	line-height: 18px;
}
.main-cont .qa-list p,
.main-cont .qa-list ol,
.main-cont .qa-list ul{
	/** Basic Box Model **/
	margin: 20px 0;
	padding: 0;
}
.main-cont .qa-list a{
	/** Color **/
	color: #ff0000;
}
.main-cont .qa-list>.question>*:first-child,
.main-cont .qa-list>.question>*.middle-part,
.main-cont .qa-list>.question>*.last-part,
.main-cont .qa-list>.answer>*:first-child,
.main-cont .qa-list>.answer>*.middle-part,
.main-cont .qa-list>.answer>*.last-part{
	/** Basic Box Model **/
	margin-top: 0;
}
.main-cont .qa-list>.question>*:last-child,
.main-cont .qa-list>.question>*.first-part,
.main-cont .qa-list>.question>*.middle-part,
.main-cont .qa-list>.answer>*:last-child,
.main-cont .qa-list>.answer>*.first-part,
.main-cont .qa-list>.answer>*.middle-part{
	/** Basic Box Model **/
	margin-bottom: 0;
}
.main-cont .qa-list>.question,
.main-cont .qa-list>.answer{
	/** Background and Borders **/
	border: 0 none #ffffff;
	border-bottom: 1px solid #cccccc;
}
.main-cont .qa-list>.question{
	/** Basic User Interface **/
	cursor: pointer;
	/** Basic Box Model **/
	padding: 9px 10px;
	/** Color **/
	color: #0066cc;
}
.main-cont .qa-list>.answer{
	/** Background and Borders **/
	background: #ecf5ff;
	/** Basic Box Model **/
	display: none;
	padding: 9px 20px;
	/** Color **/
	color: #515151;
}
.main-cont .qa-list ul.chuten>li{
	/** Positioned Layout **/
	position: relative;
	/** Basic Box Model **/
	margin: 0 0 0 18px;
	/** Positioned Layout **/
	position: relative;
	/** Basic Box Model **/
	margin-left: 18px;
	/** Fonts **/
	font-size: 14px;
}
.main-cont .qa-list ul.chuten>li::before{
	/** Positioned Layout **/
	position: absolute;
	top: 0;
	left: -16px;
	/** Basic Box Model **/
	display: block;
	/** Generated and Rplaced Content **/
	content: '・';
}
